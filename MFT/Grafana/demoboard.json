          "rawQuery": true,
          "rawSql": "SELECT TOP 50\r\n    f.Volume,\r\n    f.FullPath,\r\n    f.FileSize / 1073741824.0 AS SizeGB,\r\n    f.ModifiedTime,\r\n    f.AccessedTime\r\nFROM FileSizes.dbo.FileEntry f\r\nJOIN FileSizes.dbo.ScanBatch b ON b.BatchId = f.BatchId\r\nWHERE b.[BatchId] in (${batchid:singlequote})\r\n  AND f.IsDirectory = 0\r\nORDER BY f.FileSize DESC;",
