      "targets": [
        {
          "dataset": "FileSizes",
          "datasource": {
            "type": "mssql",
            "uid": "${winventory}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\r\nSELECT\r\n    CASE\r\n        WHEN CHARINDEX('.', REVERSE(f.FileName)) > 0\r\n        THEN LOWER(RIGHT(f.FileName, CHARINDEX('.', REVERSE(f.FileName)) - 1))\r\n        ELSE '(no ext)'\r\n    END AS Extension,\r\n    COUNT(*)                            AS FileCount,\r\n    SUM(f.FileSize) / 1073741824.0      AS TotalGB,\r\n    AVG(f.FileSize) / 1048576.0         AS AvgSizeMB,\r\n    MAX(f.FileSize) / 1073741824.0      AS LargestGB\r\nFROM [FileSizes].dbo.FileEntry f\r\nWHERE f.BatchId IN (${batchid:singlequote})\r\n  AND f.IsDirectory = 0\r\n  AND f.FileSize IS NOT NULL\r\nGROUP BY\r\n    CASE\r\n        WHEN CHARINDEX('.', REVERSE(f.FileName)) > 0\r\n        THEN LOWER(RIGHT(f.FileName, CHARINDEX('.', REVERSE(f.FileName)) - 1))\r\n        ELSE '(no ext)'\r\n    END\r\nORDER BY TotalGB DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
