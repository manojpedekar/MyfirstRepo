      "targets": [
        {
          "dataset": "FileSizes",
          "datasource": {
            "type": "mssql",
            "uid": "${winventory}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "DECLARE @BatchId5 UNIQUEIDENTIFIER = '0416EF82-58FB-422E-ABA5-FC31FB81401B';  -- replace\r\nDECLARE @DupMinSizeMB BIGINT = 10;\r\n\r\nSELECT\r\n    f.FileName,\r\n    f.FileSize / 1048576.0 AS SizeMB,\r\n    COUNT(*)               AS CopyCount,\r\n    COUNT(*) * f.FileSize / 1073741824.0 AS WastedGB\r\nFROM [FileSizes].dbo.FileEntry f\r\nWHERE f.BatchId IN (${batchid:singlequote})\r\n  AND f.IsDirectory = 0\r\n  AND f.FileSize >= @DupMinSizeMB * 1048576\r\nGROUP BY f.FileName, f.FileSize\r\nHAVING COUNT(*) > 1\r\nORDER BY WastedGB DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
