      "targets": [
        {
          "dataset": "FileSizes",
          "datasource": {
            "type": "mssql",
            "uid": "${winventory}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH LatestBatch AS (\r\n    SELECT ServerName, MAX(CollectedAtUtc) AS LatestScan\r\n    FROM FileSizes.dbo.ScanBatch\r\n    GROUP BY ServerName\r\n)\r\nSELECT\r\n    v.VolumeName,\r\n    v.VolumeLabel,\r\n    v.TotalSizeBytes / 1073741824.0   AS TotalGB,\r\n    v.FreeSizeBytes  / 1073741824.0   AS FreeGB,\r\n    CASE WHEN v.TotalSizeBytes > 0\r\n         THEN 100.0 * (v.TotalSizeBytes - v.FreeSizeBytes) / v.TotalSizeBytes\r\n         ELSE NULL\r\n    END AS PctUsed,\r\n    v.FileCount,\r\n    v.DirectoryCount,\r\n    v.ErrorCount\r\nFROM LatestBatch lb\r\nJOIN FileSizes.dbo.ScanBatch b ON b.ServerName = lb.ServerName\r\n                    AND b.CollectedAtUtc = lb.LatestScan\r\nJOIN FileSizes.dbo.ScanVolume v ON v.BatchId = b.BatchId\r\nwhere b.BatchId in (${batchid:singlequote})\r\nORDER BY b.ServerName, v.VolumeName;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
