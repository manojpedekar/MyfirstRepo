      "targets": [
        {
          "dataset": "FileSizes",
          "datasource": {
            "type": "mssql",
            "uid": "${winventory}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "DECLARE @BatchId3 UNIQUEIDENTIFIER = (${batchid:singlequote});  -- replace\r\nDECLARE @StaleDate DATETIME2(0) = DATEADD(YEAR, -2, SYSUTCDATETIME());\r\nDECLARE @MinSizeMB BIGINT = 100;\r\n\r\nSELECT\r\n    f.Volume,\r\n    f.FullPath,\r\n    f.FileSize / 1048576.0     AS SizeMB,\r\n    f.ModifiedTime,\r\n    f.AccessedTime,\r\n    DATEDIFF(DAY, f.ModifiedTime, SYSUTCDATETIME()) AS DaysSinceModified\r\nFROM [FileSizes].dbo.FileEntry f\r\nWHERE f.BatchId = @BatchId3\r\n  AND f.IsDirectory = 0\r\n  AND f.FileSize >= @MinSizeMB * 1048576\r\n  AND f.ModifiedTime < @StaleDate\r\nORDER BY f.FileSize DESC;",
          "refId": "A",
          "sql": {
            "columns": [
