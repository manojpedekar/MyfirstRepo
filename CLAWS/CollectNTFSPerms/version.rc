#include "version.h"  
#include <windows.h>  
#include <time.h>  

// Build date string for resource file (automatically updated via __DATE__ __TIME__ in version.h)
#define BUILD_DATE_STR BUILD_DATE_TIME

// Version information  
VS_VERSION_INFO VERSIONINFO  
FILEVERSION     VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0  
PRODUCTVERSION  VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0  
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK  
FILEFLAGS       0  
FILEOS          VOS_NT_WINDOWS32  
FILETYPE        VFT_APP  
FILESUBTYPE     VFT2_UNKNOWN  
BEGIN  
    BLOCK "StringFileInfo"  
    BEGIN  
        BLOCK "040904B0"  
        BEGIN  
            VALUE "CompanyName",      "Internal Utility"  
            VALUE "FileDescription",  "File System Permissions Collector"  
            VALUE "FileVersion",      VERSION_STRING  
            VALUE "InternalName",     "CollectFSPerms"  
            VALUE "LegalCopyright",   "(c) Internal Utility. All rights reserved."  
            VALUE "OriginalFilename", "CollectFSPerms.exe"  
            VALUE "ProductName",      "CollectFSPerms"  
            VALUE "ProductVersion",   VERSION_STRING  
            VALUE "BuildDate",        BUILD_DATE_STR  
        END  
    END  
    BLOCK "VarFileInfo"  
    BEGIN  
        VALUE "Translation", 0x409, 1200  
    END  
END