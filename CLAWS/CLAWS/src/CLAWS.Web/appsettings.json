{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "SqlServer": {
      "Server": "",
      "Database": "",
      "UseWindowsAuth": true,
      "Username": null,
      "Password": null,
      "ConnectionTimeout": 30,
      "CommandTimeout": 3600
    },
    "Authorization": {
      "SiteAdminGroup": "",
      "NtfsPermsAdminGroup": "",
      "AdAdminGroup": ""
    },
    "Storage": {
      "ImportBasePath": "",
      "UploadFolder": "Uploads",
      "ExtractionFolder": "Extraction",
      "CompletedFolder": "Completed",
      "ErrorsFolder": "Errors"
    },
    "UploadLimits": {
      "MaxUploadSizeBytes": 3221225472,
      "MaxExtractedSizeBytes": 53687091200,
      "MinFreeDiskSpaceBytes": 53687091200,
      "MaxConcurrentExtractions": 2,
      "MaxCompressionRatio": 100.0
    },
    "Cleanup": {
      "AutoPruneCompleted": true,
