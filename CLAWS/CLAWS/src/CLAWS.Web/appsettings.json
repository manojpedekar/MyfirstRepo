    "Import": {
      "BatchSize": 10000,
      "TransactionMode": "PerTable",
      "DuplicateHandling": "Reject"
    },
    "Logging": {
      "LogDirectory": "",
      "FileLogRetentionDays": 30,
      "FileLogLevel": "Information",
      "DatabaseLogRetentionDays": 90,
      "DatabaseLogLevel": "Information",
      "EnableDebugLogging": false
    },
    "Versions": {
      "MinimumDbVersion": null,
      "MinimumAppVersion": null
    },
    "DiskSpace": {
      "WarningThresholdPercent": 20.0,
      "CriticalThresholdPercent": 10.0,
      "EnableMonitoring": true,
      "MonitoringIntervalMinutes": 15
    },
    "DatabasePerformance": {
      "CommandTimeoutMinutes": 30,
      "ConnectionTimeoutSeconds": 30,
      "ImportBatchSize": 10000,
      "MaxConcurrentExtractions": 2
    }
