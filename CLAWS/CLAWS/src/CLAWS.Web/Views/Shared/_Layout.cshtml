@using Microsoft.AspNetCore.Authorization
@using CLAWS.Core.Configuration
@using CLAWS.Data.Entities
@using CLAWS.Web.Services
@inject AppSettings AppSettings
@inject IBannerMessageService BannerMessageService
@inject IAuthorizationService AuthorizationService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CLAWS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
        .info-banner {
            background-color: #cff4fc;
            border-bottom: 1px solid #0dcaf0;
            padding: 0.5rem 1rem;
            position: relative;
        }
        .warning-banner {
            background-color: #fff3cd;
            border-bottom: 1px solid #ffc107;
            padding: 0.5rem 1rem;
            position: relative;
        }
        .danger-banner {
            background-color: #f8d7da;
            border-bottom: 1px solid #dc3545;
            padding: 0.5rem 1rem;
            position: relative;
        }
        .banner-close {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            font-size: 1.25rem;
            cursor: pointer;
            opacity: 0.5;
            padding: 0;
            line-height: 1;
        }
        .banner-close:hover {
            opacity: 1;
        }
        .upload-progress {
            display: none;
        }
        .upload-progress.active {
            display: block;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="bi bi-database-up"></i> CLAWS
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @* Check admin access for menu visibility *@
                        var canAccessAdmin = (await AuthorizationService.AuthorizeAsync(User, "SiteAdminOnly")).Succeeded;

                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house"></i> Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Upload" asp-action="Index">
                                    <i class="bi bi-cloud-upload"></i> Upload
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Status" asp-action="Index">
                                    <i class="bi bi-list-check"></i> Status
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ProductionData" asp-action="NtfsPermissions">
                                    <i class="bi bi-folder-symlink"></i> NTFS Permissions
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ProductionData" asp-action="AdInventory">
                                    <i class="bi bi-people"></i> AD Inventory
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DomainMasterList" asp-action="Index">
                                    <i class="bi bi-diagram-3"></i> DML
                                </a>
                            </li>
                            @if (canAccessAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-gear"></i> Admin
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Help" asp-action="Index">
                                <i class="bi bi-question-circle"></i> Help
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (AppSettings.Ldap.Enabled)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="userDropdown" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-circle"></i> @User.Identity?.Name
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                        <li>
                                            <span class="dropdown-item-text text-muted small">
                                                @{
                                                    var authType = User.Claims.FirstOrDefault(c => c.Type == "AuthenticationType")?.Value;
                                                    <text>Signed in via @(authType ?? "LDAP")</text>
                                                }
                                            </span>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="MyApiKeys">
                                                <i class="bi bi-key"></i> My API Keys
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item">
                                                    <i class="bi bi-box-arrow-right"></i> Sign Out
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light" href="#" id="userDropdownWinAuth" role="button"
                                       data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-circle"></i> @User.Identity?.Name
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdownWinAuth">
                                        <li>
                                            <span class="dropdown-item-text text-muted small">
                                                Signed in via Windows
                                            </span>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="MyApiKeys">
                                                <i class="bi bi-key"></i> My API Keys
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        @{
            var activeBanners = await BannerMessageService.GetActiveAsync();
        }
        @foreach (var banner in activeBanners)
        {
            var bannerId = $"banner-{banner.BannerMessageId}";
            @if (banner.MessageType == BannerMessageTypes.Info)
            {
                <div class="info-banner text-center dismissible-banner" data-banner-id="@bannerId">
                    <i class="bi bi-info-circle"></i>
                    <strong>@banner.Title:</strong> @banner.Message
                    <button type="button" class="banner-close" onclick="dismissBanner('@bannerId')" aria-label="Close">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }
            else if (banner.MessageType == BannerMessageTypes.Warning)
            {
                <div class="warning-banner text-center dismissible-banner" data-banner-id="@bannerId">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>@banner.Title:</strong> @banner.Message
                    <button type="button" class="banner-close" onclick="dismissBanner('@bannerId')" aria-label="Close">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }
            else if (banner.MessageType == BannerMessageTypes.Error)
            {
                <div class="danger-banner text-center dismissible-banner" data-banner-id="@bannerId">
                    <i class="bi bi-x-circle"></i>
                    <strong>@banner.Title:</strong> @banner.Message
                    <button type="button" class="banner-close" onclick="dismissBanner('@bannerId')" aria-label="Close">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }
        }

        @if (!AppSettings.Authorization.IsConfigured)
        {
            <div class="warning-banner text-center dismissible-banner" data-banner-id="banner-auth-warning">
                <i class="bi bi-exclamation-triangle"></i>
                <strong>Security Warning:</strong> Authorization groups not configured.
                Any authenticated user has full access.
                <a href="/Admin/Configuration">Configure admin groups in Settings</a> to restrict access.
                <button type="button" class="banner-close" onclick="dismissBanner('banner-auth-warning')" aria-label="Close">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }

        @if (!AppSettings.SqlServer.IsConfigured)
        {
            <div class="danger-banner text-center dismissible-banner" data-banner-id="banner-db-warning">
                <i class="bi bi-database-x"></i>
                <strong>Database Not Configured:</strong>
                Upload functionality is disabled.
                <a href="/Admin/Configuration">Configure SQL Server connection</a> to enable imports.
                <button type="button" class="banner-close" onclick="dismissBanner('banner-db-warning')" aria-label="Close">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }

        @if (AppSettings.Storage.IsUsingApplicationDirectory(System.IO.Path.GetDirectoryName(typeof(Program).Assembly.Location) ?? ""))
        {
            <div class="warning-banner text-center dismissible-banner" data-banner-id="banner-storage-warning">
                <i class="bi bi-hdd"></i>
                <strong>Warning:</strong> Import storage is using the application installation directory.
                For production use, configure a dedicated volume with adequate space for large file operations.
                <button type="button" class="banner-close" onclick="dismissBanner('banner-storage-warning')" aria-label="Close">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }
    </header>

    <main class="container py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="border-top py-3 mt-4">
        <div class="container text-center text-muted">
            <small>CLAWS &copy; @DateTime.Now.Year</small>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
    <script>
        // Convert UTC times to local time
        // Elements with data-utc attribute will have their text content replaced with local time
        // Format options: "datetime" (default), "date", "time", "relative"
        function convertUtcToLocal() {
            document.querySelectorAll('[data-utc]').forEach(function(el) {
                let utcValue = el.getAttribute('data-utc');
                if (!utcValue) return;

                // If the date string doesn't have a timezone indicator, treat it as UTC
                // This handles dates from .NET's .ToString("o") which may not include "Z"
                // when DateTimeKind is Unspecified (common with EF Core)
                if (!utcValue.endsWith('Z') && !utcValue.includes('+') && !utcValue.match(/-\d{2}:\d{2}$/)) {
                    utcValue = utcValue + 'Z';
                }

                const date = new Date(utcValue);
                if (isNaN(date.getTime())) return;

                const format = el.getAttribute('data-format') || 'datetime';

                let formatted;
                switch (format) {
                    case 'date':
                        formatted = date.toLocaleDateString();
                        break;
                    case 'time':
                        formatted = date.toLocaleTimeString();
                        break;
                    case 'short':
                        formatted = date.toLocaleDateString() + ' ' + date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                        break;
                    case 'relative':
                        formatted = getRelativeTime(date);
                        break;
                    default: // datetime
                        formatted = date.toLocaleString();
                        break;
                }

                el.textContent = formatted;
                el.title = date.toLocaleString(); // Full datetime on hover
            });
        }

        function getRelativeTime(date) {
            const now = new Date();
            const diffMs = now - date;
            const diffMins = Math.floor(diffMs / 60000);
            const diffHours = Math.floor(diffMs / 3600000);
            const diffDays = Math.floor(diffMs / 86400000);

            if (diffMins < 1) return 'just now';
            if (diffMins < 60) return diffMins + ' min ago';
            if (diffHours < 24) return diffHours + ' hour' + (diffHours > 1 ? 's' : '') + ' ago';
            if (diffDays < 7) return diffDays + ' day' + (diffDays > 1 ? 's' : '') + ' ago';
            return date.toLocaleDateString();
        }

        // Run on page load
        document.addEventListener('DOMContentLoaded', convertUtcToLocal);

        // Banner dismissal functionality - persists per session using sessionStorage
        function dismissBanner(bannerId) {
            // Hide the banner
            const banner = document.querySelector('[data-banner-id="' + bannerId + '"]');
            if (banner) {
                banner.style.display = 'none';
            }
            // Store dismissal in sessionStorage
            try {
                const dismissed = JSON.parse(sessionStorage.getItem('dismissedBanners') || '[]');
                if (!dismissed.includes(bannerId)) {
                    dismissed.push(bannerId);
                    sessionStorage.setItem('dismissedBanners', JSON.stringify(dismissed));
                }
            } catch (e) {
                console.warn('Failed to save banner dismissal state:', e);
            }
        }

        // Restore dismissed banners on page load
        function restoreDismissedBanners() {
            try {
                const dismissed = JSON.parse(sessionStorage.getItem('dismissedBanners') || '[]');
                dismissed.forEach(function(bannerId) {
                    const banner = document.querySelector('[data-banner-id="' + bannerId + '"]');
                    if (banner) {
                        banner.style.display = 'none';
                    }
                });
            } catch (e) {
                console.warn('Failed to restore banner dismissal state:', e);
            }
        }

        // Run banner restoration on page load
        document.addEventListener('DOMContentLoaded', restoreDismissedBanners);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
