@model DomainEditViewModel
@* KMS Services Card - displays KMS servers discovered via DNS SRV records *@

@if (Model.AdInventory?.HasInventory == true)
{
    <div class="card mb-4">
        <div class="card-header bg-info-subtle py-2">
            <i class="bi bi-key"></i> KMS Services
            @if (Model.KmsServices?.HasServers == true)
            {
                <span class="badge bg-info ms-1">@Model.KmsServices.ServerCount</span>
            }
        </div>
        <div class="card-body p-0">
            @if (Model.KmsServices?.HasServers != true)
            {
                <div class="text-center text-muted py-3">
                    <i class="bi bi-key fs-4 d-block mb-1"></i>
                    <small>No KMS servers discovered</small>
                    <div class="small text-muted mt-1">
                        KMS may be hosted in another domain
                    </div>
                </div>
            }
            else
            {
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Hostname</th>
                            <th class="text-center" style="width: 70px;">Port</th>
                            <th class="text-center" style="width: 60px;" title="DNS SRV Priority (lower = preferred)">Pri</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var server in Model.KmsServices.Servers)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span title="@(server.ResolvedIP ?? "IP not resolved")">
                                        @server.TargetHostname
                                    </span>
                                    @if (server.RecordSource != "DNS")
                                    {
                                        <span class="badge bg-secondary ms-1" title="Manually configured">Manual</span>
                                    }
                                </td>
                                <td class="text-center text-muted">@server.Port</td>
                                <td class="text-center">
                                    @if (server.Priority.HasValue)
                                    {
                                        <span class="badge bg-light text-dark" title="Weight: @(server.Weight ?? 0)">
                                            @server.Priority
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="card-footer bg-light py-1 px-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle"></i>
                        Discovered via DNS SRV: <code>_vlmcs._tcp.@Model.Domain.DomainName</code>
                    </small>
                </div>
            }
        </div>
    </div>
}
