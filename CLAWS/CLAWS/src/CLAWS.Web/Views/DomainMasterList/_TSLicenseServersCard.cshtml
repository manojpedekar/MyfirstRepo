@model DomainEditViewModel
@* Terminal Server License Servers card - shows members of S-1-5-32-561 group *@

@if (Model.TSLicenseServers != null)
{
    <div class="card mb-4">
        <div class="card-header bg-purple-subtle d-flex justify-content-between align-items-center" style="background-color: rgba(102, 16, 242, 0.1);">
            <span>
                <i class="bi bi-pc-display-horizontal"></i> TS License Servers
                @if (Model.TSLicenseServers.HasMembers)
                {
                    <span class="badge bg-secondary ms-1">@Model.TSLicenseServers.MemberCount</span>
                }
            </span>
            @if (Model.TSLicenseServers.HasMembers)
            {
                <small class="text-muted" title="Terminal Server License Servers (S-1-5-32-561)">
                    <i class="bi bi-info-circle"></i>
                </small>
            }
        </div>
        @if (!Model.TSLicenseServers.HasMembers)
        {
            <div class="card-body text-center text-muted py-3">
                <small>No members found</small>
            </div>
        }
        else
        {
            <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Member</th>
                            <th class="text-center" style="width: 90px;">Type</th>
                            <th style="width: 120px;">OS</th>
                            <th class="text-center" style="width: 70px;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.TSLicenseServers.Members)
                        {
                            <tr class="@(member.IsWellKnown ? "table-light" : "")">
                                <td>
                                    <i class="bi @member.TypeIcon text-@member.TypeBadgeClass me-1"></i>
                                    @if (member.IsWellKnown)
                                    {
                                        <span class="text-muted">@member.DisplayName</span>
                                        <br /><small class="text-muted ms-4">@member.MemberSID</small>
                                    }
                                    else if (member.MemberType == "Unknown")
                                    {
                                        <span class="text-muted font-monospace small">@member.MemberSID</span>
                                    }
                                    else
                                    {
                                        <strong>@member.DisplayName</strong>
                                        @if (member.IsDomainController)
                                        {
                                            <span class="badge bg-info ms-1" title="Domain Controller">DC</span>
                                        }
                                        @if (member.IsFromTrustedDomain)
                                        {
                                            <br /><small class="text-muted ms-4">
                                                <i class="bi bi-link-45deg"></i> @member.ResolvedFromDomain
                                            </small>
                                        }
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-@member.TypeBadgeClass">@member.MemberType</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(member.OperatingSystem))
                                    {
                                        <small>@member.OperatingSystem</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (member.Enabled == true)
                                    {
                                        <span class="badge bg-success">Enabled</span>
                                    }
                                    else if (member.Enabled == false)
                                    {
                                        <span class="badge bg-danger">Disabled</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TSLicenseServers.Members.Any(m => m.IsWellKnown || m.IsFromTrustedDomain || m.MemberType == "Unknown"))
            {
                <div class="card-footer bg-light py-2">
                    <small class="text-muted">
                        @if (Model.TSLicenseServers.Members.Any(m => m.IsWellKnown))
                        {
                            <span><i class="bi bi-shield-check"></i> Well-known SIDs like NETWORK SERVICE are expected on DCs.</span>
                        }
                        @if (Model.TSLicenseServers.Members.Any(m => m.IsFromTrustedDomain))
                        {
                            <span class="ms-2"><i class="bi bi-link-45deg"></i> Some SIDs resolved via trust relationships.</span>
                        }
                        @if (Model.TSLicenseServers.Members.Any(m => m.MemberType == "Unknown"))
                        {
                            <span class="ms-2"><i class="bi bi-question-circle"></i> Unresolved SIDs may be from domains without inventory.</span>
                        }
                    </small>
                </div>
            }
        }
    </div>
}
