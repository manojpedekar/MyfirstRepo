<script>
    // Collection Logs Modal functionality
    (function() {
        let currentUploadId = null;
        let currentInventoryId = null;
        let currentADCollectionId = null; // For AD domain logs
        let currentPage = 1;
        let currentSortBy = 'Timestamp';
        let currentDescending = false; // Default: oldest to newest
        const pageSize = 50;

        // DOM elements
        const modal = document.getElementById('collectionLogsModal');
        const modalLabel = document.getElementById('collectionLogsModalLabel');
        const severityFilter = document.getElementById('logsSeverityFilter');
        const sourceFilter = document.getElementById('logsSourceFilter');
        const searchFilter = document.getElementById('logsSearchFilter');
        const inventoryLabel = document.getElementById('logsInventoryLabel');
        const dataSource = document.getElementById('logsDataSource');
        const showingEl = document.getElementById('logsShowing');
        const totalItemsEl = document.getElementById('logsTotalItems');
        const loadingEl = document.getElementById('logsLoading');
        const errorEl = document.getElementById('logsError');
        const errorMessageEl = document.getElementById('logsErrorMessage');
        const emptyEl = document.getElementById('logsEmpty');
        const tableContainer = document.getElementById('logsTableContainer');
        const tableBody = document.getElementById('logsTableBody');
        const pagination = document.getElementById('logsPagination');

        // Make function available globally
        window.showCollectionLogs = function(uploadId, inventoryId) {
            currentUploadId = uploadId;
            currentInventoryId = inventoryId || null;
            currentADCollectionId = null; // Reset AD collection ID
            currentPage = 1;
            currentSortBy = 'Timestamp';
            currentDescending = false; // Reset to default: oldest to newest

            // Reset filters
            severityFilter.value = '';
            sourceFilter.innerHTML = '<option value="">All Sources</option>';
            searchFilter.value = '';

            // Update modal title
            if (inventoryId) {
                modalLabel.innerHTML = '<i class="bi bi-journal-text"></i> Collection Logs (Inventory)';
            } else {
                modalLabel.innerHTML = '<i class="bi bi-journal-text"></i> Collection Logs (All Inventories)';
            }

            // Update sort icons to show default state
            updateSortIcons();

            // Show modal
            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();

            // Load logs
            loadLogs();
        };

        // Function for AD domain logs
        window.showADDomainLogs = function(uploadId, collectionId, domainName) {
            currentUploadId = uploadId;
            currentInventoryId = null; // Not used for AD domains
            currentADCollectionId = collectionId;
            currentPage = 1;
            currentSortBy = 'Timestamp';
            currentDescending = false; // Reset to default: oldest to newest

            // Reset filters
            severityFilter.value = '';
            sourceFilter.innerHTML = '<option value="">All Sources</option>';
            searchFilter.value = '';

            // Update modal title with domain name
            modalLabel.innerHTML = '<i class="bi bi-journal-text"></i> Collection Logs - ' + escapeHtml(domainName);

            // Update sort icons to show default state
            updateSortIcons();

            // Show modal
            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();

            // Load logs
            loadLogs();
        };

        // Function for all AD domain logs
        window.showAllADDomainLogs = function(uploadId) {
            currentUploadId = uploadId;
            currentInventoryId = null;
            currentADCollectionId = 'all'; // Special marker for all domains
            currentPage = 1;
            currentSortBy = 'Timestamp';
            currentDescending = false;

            // Reset filters
            severityFilter.value = '';
            sourceFilter.innerHTML = '<option value="">All Sources</option>';
            searchFilter.value = '';

            // Update modal title
            modalLabel.innerHTML = '<i class="bi bi-journal-text"></i> Collection Logs (All AD Domains)';

            // Update sort icons to show default state
            updateSortIcons();

            // Show modal
            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();

            // Load logs
            loadLogs();
        };

        window.sortLogsBy = function(column) {
            if (currentSortBy === column) {
                // Toggle direction if same column
                currentDescending = !currentDescending;
            } else {
                // New column, default to ascending
                currentSortBy = column;
                currentDescending = false;
            }
            currentPage = 1;
            updateSortIcons();
            loadLogs();
        };

        function updateSortIcons() {
            const columns = ['Timestamp', 'Severity', 'Source', 'Message'];
            columns.forEach(col => {
                const icon = document.getElementById('sort-icon-' + col);
                if (icon) {
                    if (col === currentSortBy) {
                        icon.className = 'bi sort-icon ' + (currentDescending ? 'bi-arrow-down' : 'bi-arrow-up');
                    } else {
                        icon.className = 'bi sort-icon'; // No arrow
                    }
                }
            });
        }

        window.applyLogsFilter = function() {
            currentPage = 1;
            loadLogs();
        };

        window.clearLogsFilter = function() {
            severityFilter.value = '';
            sourceFilter.value = '';
            searchFilter.value = '';
            currentPage = 1;
            loadLogs();
        };

        window.goToLogsPage = function(page) {
            currentPage = page;
            loadLogs();
        };

        // Apply filter on Enter key
        searchFilter.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                applyLogsFilter();
            }
        });

        // Apply filter on dropdown change
        severityFilter.addEventListener('change', applyLogsFilter);
        sourceFilter.addEventListener('change', applyLogsFilter);

        async function loadLogs() {
            // Show loading, hide others
            loadingEl.style.display = 'block';
            errorEl.style.display = 'none';
            emptyEl.style.display = 'none';
            tableContainer.style.display = 'none';
            pagination.style.display = 'none';

            try {
                // Build URL based on whether this is an AD domain or regular inventory log
                let url = `/api/collection-logs/${currentUploadId}`;
                if (currentADCollectionId === 'all') {
                    // All AD domain logs
                    url += `/ad-domain`;
                } else if (currentADCollectionId !== null) {
                    // Specific AD domain logs
                    url += `/ad-domain/${currentADCollectionId}`;
                } else if (currentInventoryId) {
                    url += `/${currentInventoryId}`;
                }

                const params = new URLSearchParams();
                params.append('page', currentPage);
                params.append('pageSize', pageSize);
                params.append('sortBy', currentSortBy);
                params.append('descending', currentDescending);

                if (severityFilter.value) {
                    params.append('severity', severityFilter.value);
                }
                if (sourceFilter.value) {
                    params.append('source', sourceFilter.value);
                }
                if (searchFilter.value.trim()) {
                    params.append('search', searchFilter.value.trim());
                }

                url += '?' + params.toString();

                const response = await fetch(url, {
                    credentials: 'same-origin'
                });

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const result = await response.json();

                if (!result.success) {
                    throw new Error(result.error || 'Unknown error');
                }

                const data = result.data;

                // Update info bar
                inventoryLabel.textContent = data.inventoryLabel || 'Unknown';
                // Display the actual schema name with staging/merged suffix
                const schemaDisplay = data.dataSource + (data.isMerged ? ' (Merged)' : ' (Staging)');
                dataSource.textContent = schemaDisplay;
                dataSource.className = data.isMerged ? 'badge bg-success ms-2' : 'badge bg-warning text-dark ms-2';

                // Update source filter options
                if (data.availableSources && data.availableSources.length > 0) {
                    const currentSource = sourceFilter.value;
                    sourceFilter.innerHTML = '<option value="">All Sources</option>';
                    data.availableSources.forEach(source => {
                        const option = document.createElement('option');
                        option.value = source;
                        option.textContent = source;
                        sourceFilter.appendChild(option);
                    });
                    sourceFilter.value = currentSource;
                }

                // Update counts
                const startItem = (data.page - 1) * data.pageSize + 1;
                const endItem = Math.min(data.page * data.pageSize, data.totalItems);
                showingEl.textContent = data.totalItems > 0 ? `${startItem}-${endItem}` : '0';
                totalItemsEl.textContent = data.totalItems.toLocaleString();

                loadingEl.style.display = 'none';

                if (data.logs.length === 0) {
                    emptyEl.style.display = 'block';
                    return;
                }

                // Render logs table
                tableBody.innerHTML = '';
                data.logs.forEach(log => {
                    const row = document.createElement('tr');

                    // Timestamp
                    const timestampCell = document.createElement('td');
                    const timestamp = new Date(log.timestamp);
                    timestampCell.textContent = timestamp.toLocaleString();
                    timestampCell.title = log.timestamp;
                    row.appendChild(timestampCell);

                    // Severity
                    const severityCell = document.createElement('td');
                    const badge = document.createElement('span');
                    badge.className = 'badge ' + log.severityBadgeClass;
                    badge.textContent = log.severity;
                    severityCell.appendChild(badge);
                    row.appendChild(severityCell);

                    // Source
                    const sourceCell = document.createElement('td');
                    sourceCell.innerHTML = '<small class="text-muted">' + escapeHtml(log.source) + '</small>';
                    row.appendChild(sourceCell);

                    // Message
                    const messageCell = document.createElement('td');
                    let messageHtml = escapeHtml(log.message);
                    if (log.path) {
                        messageHtml += '<br><small class="text-muted"><i class="bi bi-folder2"></i> ' + escapeHtml(log.path) + '</small>';
                    }
                    if (log.errorCode) {
                        messageHtml += '<br><small class="text-danger">Error Code: ' + log.errorCode + '</small>';
                    }
                    messageCell.innerHTML = messageHtml;
                    row.appendChild(messageCell);

                    // View button
                    const viewCell = document.createElement('td');
                    viewCell.style.textAlign = 'center';
                    const viewBtn = document.createElement('button');
                    viewBtn.type = 'button';
                    viewBtn.className = 'btn btn-sm btn-outline-primary';
                    viewBtn.title = 'View full log details';
                    viewBtn.innerHTML = '<i class="bi bi-eye"></i>';
                    viewBtn.onclick = function() { showLogDetails(log); };
                    viewCell.appendChild(viewBtn);
                    row.appendChild(viewCell);

                    tableBody.appendChild(row);
                });

                tableContainer.style.display = 'block';

                // Render pagination
                if (data.totalPages > 1) {
                    renderPagination(data.page, data.totalPages);
                    pagination.style.display = 'block';
                }

            } catch (err) {
                loadingEl.style.display = 'none';
                errorEl.style.display = 'block';
                errorMessageEl.textContent = err.message || 'Failed to load collection logs';
                console.error('Error loading collection logs:', err);
            }
        }

        function renderPagination(currentPage, totalPages) {
            const ul = pagination.querySelector('ul');
            ul.innerHTML = '';

            // Previous button
            const prevLi = document.createElement('li');
            prevLi.className = 'page-item' + (currentPage === 1 ? ' disabled' : '');
            prevLi.innerHTML = '<a class="page-link" href="#" onclick="goToLogsPage(' + (currentPage - 1) + '); return false;">&laquo;</a>';
            ul.appendChild(prevLi);

            // Page numbers
            const maxVisible = 5;
            let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
            let endPage = Math.min(totalPages, startPage + maxVisible - 1);
            if (endPage - startPage + 1 < maxVisible) {
                startPage = Math.max(1, endPage - maxVisible + 1);
            }

            if (startPage > 1) {
                ul.appendChild(createPageItem(1, currentPage));
                if (startPage > 2) {
                    const ellipsis = document.createElement('li');
                    ellipsis.className = 'page-item disabled';
                    ellipsis.innerHTML = '<span class="page-link">...</span>';
                    ul.appendChild(ellipsis);
                }
            }

            for (let i = startPage; i <= endPage; i++) {
                ul.appendChild(createPageItem(i, currentPage));
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    const ellipsis = document.createElement('li');
                    ellipsis.className = 'page-item disabled';
                    ellipsis.innerHTML = '<span class="page-link">...</span>';
                    ul.appendChild(ellipsis);
                }
                ul.appendChild(createPageItem(totalPages, currentPage));
            }

            // Next button
            const nextLi = document.createElement('li');
            nextLi.className = 'page-item' + (currentPage === totalPages ? ' disabled' : '');
            nextLi.innerHTML = '<a class="page-link" href="#" onclick="goToLogsPage(' + (currentPage + 1) + '); return false;">&raquo;</a>';
            ul.appendChild(nextLi);
        }

        function createPageItem(page, currentPage) {
            const li = document.createElement('li');
            li.className = 'page-item' + (page === currentPage ? ' active' : '');
            li.innerHTML = '<a class="page-link" href="#" onclick="goToLogsPage(' + page + '); return false;">' + page + '</a>';
            return li;
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Show log details modal
        window.showLogDetails = function(log) {
            const detailModal = document.getElementById('logDetailModal');
            const timestamp = new Date(log.timestamp);

            // Populate modal fields
            document.getElementById('detailEventId').textContent = log.eventId;
            document.getElementById('detailTimestamp').textContent = timestamp.toLocaleString();
            document.getElementById('detailSeverity').innerHTML = '<span class="badge ' + log.severityBadgeClass + '">' + escapeHtml(log.severity) + '</span>';
            document.getElementById('detailSource').textContent = log.source || 'N/A';
            document.getElementById('detailMessage').textContent = log.message || 'N/A';
            document.getElementById('detailPath').textContent = log.path || 'N/A';
            document.getElementById('detailErrorCode').textContent = log.errorCode || 'N/A';
            document.getElementById('detailContext').textContent = log.context || 'N/A';
            document.getElementById('detailExceptionType').textContent = log.exceptionType || 'N/A';
            document.getElementById('detailExceptionMessage').textContent = log.exceptionMessage || 'N/A';

            // Show/hide AD-specific fields based on whether they have data
            const hasAdFields = log.context || log.exceptionType || log.exceptionMessage;
            document.getElementById('adFieldsSection').style.display = hasAdFields ? 'block' : 'none';

            // Show the modal
            const bsModal = new bootstrap.Modal(detailModal);
            bsModal.show();
        };
    })();
</script>
