@model UploadItem
@{
    ViewData["Title"] = "Upload Details";

    var validationStatusClass = Model.ValidationStatus switch
    {
        "Passed" => "text-success",
        "Failed" => "text-danger",
        "InProgress" => "text-primary",
        _ => "text-muted"
    };

    var validationBadgeClass = Model.ValidationStatus switch
    {
        "Passed" => "bg-success",
        "Failed" => "bg-danger",
        "InProgress" => "bg-primary",
        _ => "bg-secondary"
    };

    var mergeStatusClass = Model.MergeStatus switch
    {
        "Merged" => "text-success",
        "PartiallyMerged" => "text-warning",
        "Failed" => "text-danger",
        "InProgress" => "text-primary",
        _ => "text-muted"
    };

    var mergeBadgeClass = Model.MergeStatus switch
    {
        "Merged" => "bg-success",
        "PartiallyMerged" => "bg-warning text-dark",
        "Failed" => "bg-danger",
        "InProgress" => "bg-primary",
        _ => "bg-secondary"
    };

    var isValidating = Model.ValidationStatus == "InProgress";
    var isMerging = Model.MergeStatus == "InProgress";
}

@section Styles {
    <style>
        .spin {
            animation: spin 1s linear infinite;
            display: inline-block;
        }
        @@keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        /* Sortable column headers */
        #logsTableContainer th[data-sort-column] {
            user-select: none;
        }
        #logsTableContainer th[data-sort-column]:hover {
            background-color: #e9ecef;
        }
        #logsTableContainer .sort-icon {
            font-size: 0.75rem;
            margin-left: 0.25rem;
            opacity: 0.7;
        }
        #logsTableContainer th[data-sort-column]:hover .sort-icon {
            opacity: 1;
        }
    </style>
}

<h1 class="mb-4">
    <i class="bi bi-file-earmark-zip"></i> Upload Details
</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header">
                <i class="bi bi-info-circle"></i> @Model.OriginalFilename
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Upload ID</dt>
                    <dd class="col-sm-8"><code>@Model.UploadId</code></dd>

                    <dt class="col-sm-4">Filename</dt>
                    <dd class="col-sm-8">@Model.OriginalFilename</dd>

                    <dt class="col-sm-4">File Size</dt>
                    <dd class="col-sm-8">@((Model.FileSizeBytes / 1024.0 / 1024.0).ToString("N2")) MB (@Model.FileSizeBytes.ToString("N0") bytes)</dd>

                    <dt class="col-sm-4">Upload Type</dt>
                    <dd class="col-sm-8">
                        @{
                            var uploadTypeDisplay = Model.UploadType switch
                            {
                                "NTFSPermissions" => "NTFS Permissions",
                                "ADInventory" => "AD Inventory",
                                _ => Model.UploadType ?? "Unknown"
                            };
                            var uploadTypeBadgeClass = Model.UploadType switch
                            {
                                "NTFSPermissions" => "bg-primary",
                                "ADInventory" => "bg-info",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @uploadTypeBadgeClass">@uploadTypeDisplay</span>
                    </dd>

                    <dt class="col-sm-4">Import Status</dt>
                    <dd class="col-sm-8">
                        @{
                            var statusClass = Model.Status switch
                            {
                                "Completed" => "bg-success",
                                "Failed" => "bg-danger",
                                "Cancelled" => "bg-warning text-dark",
                                "Importing" => "bg-info",
                                "Processing" => "bg-info",
                                "Pending" => "bg-warning text-dark",
                                "Queued" => "bg-secondary",
                                "Validating" => "bg-primary",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @statusClass">@Model.Status</span>
                        @if (!string.IsNullOrEmpty(Model.CurrentPhase))
                        {
                            <br><small class="text-muted">@Model.CurrentPhase</small>
                        }
                    </dd>

                    @if (Model.Status is "Importing" or "Processing")
                    {
                        <dt class="col-sm-4">Progress</dt>
                        <dd class="col-sm-8">
                            <div class="progress" style="height: 25px;">
                                <div id="progress-bar" class="progress-bar progress-bar-striped progress-bar-animated"
                                     role="progressbar"
                                     style="width: @(Model.ImportProgress ?? 0)%;"
                                     aria-valuenow="@(Model.ImportProgress ?? 0)"
                                     aria-valuemin="0"
                                     aria-valuemax="100">
                                    <span id="progress-percent">@(Model.ImportProgress ?? 0)%</span>
                                </div>
                            </div>
                            <div id="progress-details" class="mt-2">
                                <small class="text-muted">
                                    <span id="rows-processed">0</span> / <span id="total-rows">0</span> records
                                    <span class="mx-2">|</span>
                                    <span id="records-per-sec">0</span> rec/s
                                    <span class="mx-2">|</span>
                                    ETA: <span id="eta">--:--</span>
                                </small>
                            </div>
                        </dd>
                    }

                    <dt class="col-sm-4">Uploaded At</dt>
                    <dd class="col-sm-8"><span data-utc="@Model.UploadedAt.ToString("o")">@Model.UploadedAt.ToString("F")</span></dd>

                    @if (Model.CompletedAt.HasValue)
                    {
                        <dt class="col-sm-4">Import Completed</dt>
                        <dd class="col-sm-8"><span data-utc="@Model.CompletedAt.Value.ToString("o")">@Model.CompletedAt.Value.ToString("F")</span></dd>

                        <dt class="col-sm-4">Duration</dt>
                        <dd class="col-sm-8">@((Model.CompletedAt.Value - Model.UploadedAt).ToString(@"hh\:mm\:ss"))</dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.StatusMessage))
                    {
                        <dt class="col-sm-4">Message</dt>
                        <dd class="col-sm-8">
                            @if (Model.Status == "Failed")
                            {
                                <div class="alert alert-danger mb-0">
                                    <i class="bi bi-exclamation-triangle"></i> @Model.StatusMessage
                                </div>
                                @if (Model.IsDuplicateError)
                                {
                                    <div class="alert alert-warning mt-2 mb-0">
                                        <h6 class="alert-heading"><i class="bi bi-info-circle"></i> How to Resolve</h6>
                                        <p class="mb-2">This upload was rejected because one or more InventoryIDs already exist in the system.</p>
                                        <ul class="mb-0">
                                            <li><strong>If duplicate is in staging (pending merge):</strong> Go to All Uploads, find the previous import, and delete it before re-uploading.</li>
                                            <li><strong>If duplicate is in production (already merged):</strong> This data has already been merged. Contact an administrator if you need to re-import.</li>
                                        </ul>
                                    </div>
                                }
                            }
                            else
                            {
                                <span>@Model.StatusMessage</span>
                            }
                        </dd>
                    }
                </dl>
            </div>
        </div>

        @if (Model.Status == "Completed")
        {
            @if (Model.UploadType == "ADInventory" && Model.DomainCollections.Any())
            {
                <!-- ADInventory: Show AD Domains card -->
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-diagram-3"></i> AD Domains (@Model.DomainCollections.Count)</span>
                        @if (Model.TotalRecordsImported.HasValue)
                        {
                            <span class="badge bg-secondary">@Model.TotalRecordsImported.Value.ToString("N0") records</span>
                        }
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Domain Name</th>
                                    <th>Collected</th>
                                    <th class="text-end">Records</th>
                                    <th class="text-center" style="width: 70px;">Logs</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var domain in Model.DomainCollections.OrderBy(d => d.DomainName))
                                {
                                    <tr>
                                        <td>@domain.DomainName</td>
                                        <td>
                                            @if (domain.CollectionDateTime.HasValue)
                                            {
                                                <span data-utc="@domain.CollectionDateTime.Value.ToString("o")" data-format="short">@domain.CollectionDateTime.Value.ToString("g")</span>
                                            }
                                            else
                                            {
                                                <text>N/A</text>
                                            }
                                        </td>
                                        <td class="text-end">@domain.TotalRecords.ToString("N0")</td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    onclick="showADDomainLogs('@Model.UploadId', '@domain.CollectionId', '@domain.DomainName')"
                                                    title="View collection logs for this domain">
                                                <i class="bi bi-journal-text"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (Model.UploadType != "ADInventory" && Model.Inventories.Any())
            {
                <!-- NTFSPermissions: Show Inventories card -->
                <div class="card mb-3">
                    <div class="card-header">
                        <i class="bi bi-collection"></i> Inventories (@Model.Inventories.Count)
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm table-striped mb-0">
                            <thead>
                                <tr>
                                    <th>Computer</th>
                                    <th>Scan Path</th>
                                    <th>Collected</th>
                                    <th class="text-end">Records</th>
                                    <th class="text-center" style="width: 70px;">Logs</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inv in Model.Inventories)
                                {
                                    <tr>
                                        <td>@(inv.ComputerName ?? "Unknown")</td>
                                        <td><small class="text-muted">@(inv.ScanPath ?? "N/A")</small></td>
                                        <td>
                                            @if (inv.CollectionDateTime.HasValue)
                                            {
                                                <span data-utc="@inv.CollectionDateTime.Value.ToString("o")" data-format="short">@inv.CollectionDateTime.Value.ToString("g")</span>
                                            }
                                            else
                                            {
                                                <text>N/A</text>
                                            }
                                        </td>
                                        <td class="text-end">@inv.TotalRecords.ToString("N0")</td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    onclick="showCollectionLogs('@Model.UploadId', '@inv.InventoryId')"
                                                    title="View collection logs for this inventory">
                                                <i class="bi bi-journal-text"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }

        @if (Model.Status == "Completed")
        {
            <div class="card mb-3">
                <div class="card-header">
                    <i class="bi bi-clipboard-check"></i> Validation & Merge Status
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Validation</h6>
                            <p class="mb-1">
                                <span class="badge @validationBadgeClass">@Model.ValidationStatus</span>
                                @if (Model.ValidationCompletedAt.HasValue)
                                {
                                    <small class="text-muted ms-2"><span data-utc="@Model.ValidationCompletedAt.Value.ToString("o")" data-format="short">@Model.ValidationCompletedAt.Value.ToString("g")</span></small>
                                }
                            </p>
                            @if (Model.ValidationStatus == "Failed")
                            {
                                <a href="@Url.Action("Logs", "Admin", new { uploadId = Model.UploadId, category = "Validation" })"
                                   class="btn btn-sm btn-outline-danger" target="_blank">
                                    <i class="bi bi-journal-text"></i> View Validation Errors
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(Model.ValidationMessage))
                            {
                                <small class="@validationStatusClass">@Model.ValidationMessage</small>
                            }
                        </div>
                        <div class="col-md-6">
                            <h6>Merge</h6>
                            <p class="mb-1">
                                <span class="badge @mergeBadgeClass">@Model.MergeStatus</span>
                                @if (Model.MergeCompletedAt.HasValue)
                                {
                                    <small class="text-muted ms-2"><span data-utc="@Model.MergeCompletedAt.Value.ToString("o")" data-format="short">@Model.MergeCompletedAt.Value.ToString("g")</span></small>
                                }
                            </p>
                            @if (Model.MergeStatus == "Failed")
                            {
                                <a href="@Url.Action("Logs", "Admin", new { uploadId = Model.UploadId, category = "Import" })"
                                   class="btn btn-sm btn-outline-danger" target="_blank">
                                    <i class="bi bi-journal-text"></i> View Merge Errors
                                </a>
                            }
                            else if (!string.IsNullOrEmpty(Model.MergeMessage))
                            {
                                <small class="@mergeStatusClass">@Model.MergeMessage</small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-gear"></i> Actions
            </div>
            <div class="card-body">
                @if (Model.Status is "Pending" or "Processing" or "Queued" or "Uploading" or "Importing")
                {
                    <form asp-controller="Upload" asp-action="Cancel" asp-route-id="@Model.UploadId" method="post" class="mb-2">
                        <button type="submit" class="btn btn-warning w-100"
                                onclick="return confirm('Are you sure you want to cancel? Any data already imported will remain in the database.');">
                            <i class="bi bi-x-circle"></i> Cancel @(Model.Status is "Importing" or "Processing" ? "Processing" : "Upload")
                        </button>
                    </form>
                }

                @if (Model.Status == "Pending")
                {
                    <div class="alert alert-warning mb-2">
                        <i class="bi bi-clock"></i> Waiting in queue...
                        <br><small>Processing will begin when resources are available.</small>
                    </div>
                }

                @if (Model.Status is "Importing" or "Processing")
                {
                    <div class="alert alert-info mb-2">
                        <i class="bi bi-hourglass-split"></i> <span id="status-text">@(Model.Status == "Importing" ? "Import" : "Processing") in progress...</span>
                        <br><small id="current-phase" class="text-muted">@Model.CurrentPhase</small>
                    </div>
                }

                @if (Model.Status == "Completed")
                {
                    @if (Model.MergeStatus == "Merged")
                    {
                        <div class="alert alert-success mb-2">
                            <i class="bi bi-check-circle-fill"></i> <strong>Merge Complete</strong>
                            <br><small>All data has been migrated to fsapp schema.</small>
                        </div>
                    }
                    else if (isValidating || isMerging)
                    {
                        <div class="alert alert-info mb-2">
                            <i class="bi bi-arrow-repeat spin"></i> <strong>@(isValidating ? "Validating..." : "Merging...")</strong>
                            <br><small class="text-muted">@(Model.ValidationMessage ?? Model.MergeMessage ?? "Please wait...")</small>
                        </div>
                    }
                    else
                    {
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-database-add"></i> Merge to fsapp</span>
                                @if (Model.ValidationStatus == "Passed")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check"></i> Validated</span>
                                }
                                else if (Model.ValidationStatus == "Failed")
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x"></i> Failed</span>
                                }
                            </div>
                            <div class="card-body">
                                <p class="small text-muted mb-2">
                                    Validate and merge imported data to the fsapp schema for reporting.
                                </p>
                                <form id="validateAndMergeForm" asp-controller="Status" asp-action="ValidateAndMerge" asp-route-id="@Model.UploadId" method="post" class="mb-2">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary w-100">
                                        <i class="bi bi-arrow-right-circle"></i> Validate & Merge
                                    </button>
                                </form>
                                <div class="btn-group w-100" role="group">
                                    <form id="validateOnlyForm" asp-controller="Status" asp-action="Validate" asp-route-id="@Model.UploadId" method="post" style="flex: 1;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary w-100" title="Run validation only">
                                            <i class="bi bi-check2-square"></i> Validate
                                        </button>
                                    </form>
                                    <form id="mergeOnlyForm" asp-controller="Status" asp-action="Merge" asp-route-id="@Model.UploadId" method="post" style="flex: 1;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-secondary w-100" title="Merge without validation (not recommended)">
                                            <i class="bi bi-box-arrow-in-right"></i> Merge
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }

                @if (Model.Status == "Failed")
                {
                    <div class="alert alert-danger mb-2">
                        <i class="bi bi-exclamation-triangle"></i> Import failed. Check the error message for details.
                    </div>
                }

                @if (Model.Status is "Failed" or "Completed" or "Cancelled")
                {
                    <form asp-controller="Status" asp-action="Delete" asp-route-id="@Model.UploadId" method="post" class="mb-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger w-100"
                                onclick="return confirm('Are you sure you want to delete this upload and all associated files? This action cannot be undone.');">
                            <i class="bi bi-trash"></i> Delete Upload
                        </button>
                    </form>
                }

                @if (Model.Status == "Completed" && Model.UploadType != "ADInventory" && Model.Inventories.Any())
                {
                    <button type="button" class="btn btn-outline-info w-100 mb-2"
                            onclick="showCollectionLogs('@Model.UploadId')">
                        <i class="bi bi-journal-text"></i> View Collection Logs
                    </button>
                }
                @if (Model.Status == "Completed" && Model.UploadType == "ADInventory" && Model.DomainCollections.Any())
                {
                    <button type="button" class="btn btn-outline-info w-100 mb-2"
                            onclick="showAllADDomainLogs('@Model.UploadId')">
                        <i class="bi bi-journal-text"></i> View All Collection Logs
                    </button>
                }

                <a asp-controller="Status" asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-left"></i> Back to My Uploads
                </a>
            </div>
        </div>

        @if (Model.Status is "Pending")
        {
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-arrow-repeat"></i> Auto-Refresh</span>
                    <span id="countdown-badge" class="badge bg-primary">5s</span>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="autoRefreshToggle" checked>
                        <label class="form-check-label" for="autoRefreshToggle">Enable auto-refresh</label>
                    </div>
                    <button type="button" class="btn btn-outline-primary w-100" onclick="location.reload();">
                        <i class="bi bi-arrow-clockwise"></i> Refresh Now
                    </button>
                </div>
            </div>
        }
        @if (Model.Status is "Processing" or "Importing")
        {
            <div class="card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-activity"></i> Live Progress</span>
                    <span id="poll-status" class="badge bg-success">Live</span>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="liveUpdateToggle" checked>
                        <label class="form-check-label" for="liveUpdateToggle">Enable live updates</label>
                    </div>
                    <small class="text-muted">Updates every second</small>
                </div>
            </div>
        }
    </div>
</div>

@if (Model.Status is "Pending")
{
    <script>
        (function() {
            const REFRESH_INTERVAL = 5; // seconds
            let countdown = REFRESH_INTERVAL;
            let autoRefreshEnabled = true;
            let intervalId = null;

            const toggle = document.getElementById('autoRefreshToggle');
            const badge = document.getElementById('countdown-badge');

            function updateCountdown() {
                if (!autoRefreshEnabled) return;

                countdown--;
                badge.textContent = countdown + 's';

                if (countdown <= 0) {
                    location.reload();
                }
            }

            function startAutoRefresh() {
                countdown = REFRESH_INTERVAL;
                badge.textContent = countdown + 's';
                badge.classList.remove('bg-secondary');
                badge.classList.add('bg-primary');
                intervalId = setInterval(updateCountdown, 1000);
            }

            function stopAutoRefresh() {
                if (intervalId) {
                    clearInterval(intervalId);
                    intervalId = null;
                }
                badge.textContent = 'Off';
                badge.classList.remove('bg-primary');
                badge.classList.add('bg-secondary');
            }

            if (toggle) {
                toggle.addEventListener('change', function() {
                    autoRefreshEnabled = this.checked;
                    if (autoRefreshEnabled) {
                        startAutoRefresh();
                    } else {
                        stopAutoRefresh();
                    }
                });
            }

            // Start auto-refresh on page load
            startAutoRefresh();
        })();
    </script>
}

@if (Model.Status is "Processing" or "Importing")
{
    @section Scripts {
    <script>
        (function() {
            const uploadId = '@Model.UploadId';
            let liveUpdateEnabled = true;
            let signalRConnected = false;

            console.log("Details page initialized for upload:", uploadId);

            // UI elements
            const toggle = document.getElementById('liveUpdateToggle');
            const pollStatus = document.getElementById('poll-status');
            const progressBar = document.getElementById('progress-bar');
            const progressPercent = document.getElementById('progress-percent');
            const rowsProcessed = document.getElementById('rows-processed');
            const totalRows = document.getElementById('total-rows');
            const recordsPerSec = document.getElementById('records-per-sec');
            const etaEl = document.getElementById('eta');
            const currentPhase = document.getElementById('current-phase');
            const statusText = document.getElementById('status-text');
            const messageEl = document.querySelector('dd .text-muted span, dd span:not([id])');

            // Track for records/sec calculation
            let lastRowsProcessed = 0;
            let lastUpdateTime = Date.now();

            function formatNumber(num) {
                return num.toLocaleString();
            }

            function formatEta(seconds) {
                if (!seconds || seconds <= 0) return '--:--';
                if (seconds > 3600) {
                    const hours = Math.floor(seconds / 3600);
                    const mins = Math.floor((seconds % 3600) / 60);
                    return hours + 'h ' + mins + 'm';
                }
                const mins = Math.floor(seconds / 60);
                const secs = seconds % 60;
                return mins + ':' + secs.toString().padStart(2, '0');
            }

            function updateProgress(data) {
                console.log('Progress update received:', data);

                // Update progress bar
                if (progressBar) {
                    progressBar.style.width = data.percent + '%';
                    progressBar.setAttribute('aria-valuenow', data.percent);
                }
                if (progressPercent) {
                    progressPercent.textContent = data.percent + '%';
                }

                // Parse rows from message if available (format: "Importing X: N / M rows")
                const messageMatch = data.message?.match(/:\s*([\d,]+)\s*\/\s*([\d,]+)\s*rows/i);
                if (messageMatch) {
                    const currentRows = parseInt(messageMatch[1].replace(/,/g, ''));
                    const totalRowsVal = parseInt(messageMatch[2].replace(/,/g, ''));

                    if (rowsProcessed) rowsProcessed.textContent = formatNumber(currentRows);
                    if (totalRows) totalRows.textContent = formatNumber(totalRowsVal);

                    // Calculate records per second
                    const now = Date.now();
                    const timeDiff = (now - lastUpdateTime) / 1000;
                    if (timeDiff > 0 && currentRows > lastRowsProcessed) {
                        const rps = Math.round((currentRows - lastRowsProcessed) / timeDiff);
                        if (recordsPerSec) recordsPerSec.textContent = formatNumber(rps);

                        // Calculate ETA
                        if (rps > 0 && totalRowsVal > currentRows) {
                            const remaining = totalRowsVal - currentRows;
                            const eta = Math.ceil(remaining / rps);
                            if (etaEl) etaEl.textContent = formatEta(eta);
                        }
                    }
                    lastRowsProcessed = currentRows;
                    lastUpdateTime = now;
                }

                // Update phase
                if (currentPhase && data.currentTable) {
                    currentPhase.textContent = data.currentTable;
                }

                // Flash indicator
                flashPollStatus();

                // Check if complete
                if (data.phase === 'Complete' || data.phase === 'Failed' || data.phase === 'Cancelled') {
                    setTimeout(function() { location.reload(); }, 500);
                }
            }

            function flashPollStatus() {
                if (pollStatus) {
                    pollStatus.classList.add('bg-info');
                    pollStatus.classList.remove('bg-success');
                    setTimeout(() => {
                        pollStatus.classList.remove('bg-info');
                        pollStatus.classList.add('bg-success');
                    }, 200);
                }
            }

            function setConnectionStatus(connected) {
                signalRConnected = connected;
                if (pollStatus) {
                    if (connected) {
                        pollStatus.textContent = 'Live';
                        pollStatus.classList.remove('bg-secondary', 'bg-danger');
                        pollStatus.classList.add('bg-success');
                    } else {
                        pollStatus.textContent = 'Connecting...';
                        pollStatus.classList.remove('bg-success', 'bg-danger');
                        pollStatus.classList.add('bg-secondary');
                    }
                }
            }

            // Initialize SignalR connection
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/upload")
                .withAutomaticReconnect([0, 1000, 2000, 5000, 10000])
                .build();

            connection.on("ProgressUpdate", function(data) {
                console.log("ProgressUpdate received:", data);
                console.log("Comparing uploadId:", { received: data.uploadId, expected: uploadId, match: data.uploadId === uploadId });

                if (data.uploadId === uploadId && liveUpdateEnabled) {
                    console.log("Update matches - calling updateProgress");
                    updateProgress(data);
                } else if (data.uploadId !== uploadId) {
                    console.log("Upload ID mismatch - ignoring");
                }
            });

            connection.onreconnecting(function() {
                console.log("SignalR reconnecting...");
                setConnectionStatus(false);
            });

            connection.onreconnected(function() {
                console.log("SignalR reconnected");
                setConnectionStatus(true);
                // Re-subscribe after reconnection
                connection.invoke("SubscribeToUpload", uploadId)
                    .catch(function(err) { console.error("Failed to re-subscribe:", err); });
            });

            connection.onclose(function() {
                console.log("SignalR connection closed");
                setConnectionStatus(false);
            });

            // Start connection
            connection.start()
                .then(function() {
                    console.log("SignalR connected for details page");
                    setConnectionStatus(true);
                    return connection.invoke("SubscribeToUpload", uploadId);
                })
                .then(function() {
                    console.log("Subscribed to upload:", uploadId);
                })
                .catch(function(err) {
                    console.error("SignalR connection failed:", err);
                    setConnectionStatus(false);
                });

            // Handle toggle
            if (toggle) {
                toggle.addEventListener('change', function() {
                    liveUpdateEnabled = this.checked;
                    if (!liveUpdateEnabled && pollStatus) {
                        pollStatus.textContent = 'Paused';
                        pollStatus.classList.remove('bg-success');
                        pollStatus.classList.add('bg-secondary');
                    } else if (liveUpdateEnabled && signalRConnected && pollStatus) {
                        pollStatus.textContent = 'Live';
                        pollStatus.classList.remove('bg-secondary');
                        pollStatus.classList.add('bg-success');
                    }
                });
            }
        })();
    </script>
    }
}

