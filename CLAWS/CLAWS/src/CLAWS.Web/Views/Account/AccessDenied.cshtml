@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white text-center">
                <h4 class="mb-0">
                    <i class="bi bi-shield-x"></i> Access Denied
                </h4>
            </div>
            <div class="card-body text-center">
                <p class="lead">
                    You do not have permission to access this resource.
                </p>
                <p class="text-muted">
                    Please contact your administrator if you believe this is an error.
                </p>
                <div class="mt-4">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">
                        <i class="bi bi-house"></i> Return Home
                    </a>
                    @if (ViewData["ReturnUrl"] != null)
                    {
                        <a href="@Url.Action("Login", "Account", new { returnUrl = ViewData["ReturnUrl"] })" class="btn btn-outline-secondary ms-2">
                            <i class="bi bi-person-badge"></i> Sign In with Different Account
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
