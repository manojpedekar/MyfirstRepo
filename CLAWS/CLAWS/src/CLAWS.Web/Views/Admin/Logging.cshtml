@model LoggingConfigViewModel
@{
    ViewData["Title"] = "Logging Configuration";
}

<h1 class="mb-4">
    <i class="bi bi-bug"></i> Logging Configuration
</h1>

<form asp-action="SaveLoggingConfig" method="post">
    <div class="row">
        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-toggles"></i> Logging Modes
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="enableExtendedLogging"
                               name="EnableExtendedLogging" value="true" @(Model.EnableExtendedLogging ? "checked" : "")>
                        <label class="form-check-label" for="enableExtendedLogging">
                            <strong>Enable Extended Logging</strong>
                        </label>
                        <div class="form-text">
                            Logs detailed information about authentication, authorization, and diagnostics:
                            <ul class="mb-0 mt-1">
                                <li>User group memberships during login</li>
                                <li>Authorization role matching details</li>
                                <li>LDAP authentication flow</li>
                                <li>Import/migration operation details</li>
                            </ul>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="enableRequestLogging"
                               name="EnableRequestLogging" value="true" @(Model.EnableRequestLogging ? "checked" : "")>
                        <label class="form-check-label" for="enableRequestLogging">
                            <strong>Enable Request Logging</strong>
                        </label>
                        <div class="form-text text-warning">
                            <i class="bi bi-exclamation-triangle"></i> Logs HTTP request/response details for API calls.
                            <strong>Warning:</strong> May expose sensitive data in logs. Use only for debugging.
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="enablePerformanceLogging"
                               name="EnablePerformanceLogging" value="true" @(Model.EnablePerformanceLogging ? "checked" : "")>
                        <label class="form-check-label" for="enablePerformanceLogging">
                            <strong>Enable Performance Logging</strong>
                        </label>
                        <div class="form-text">
                            Logs timing information for operations that exceed the threshold.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="performanceThresholdMs" class="form-label">Performance Threshold (ms)</label>
                        <input type="number" class="form-control" id="performanceThresholdMs"
                               name="PerformanceThresholdMs" value="@Model.PerformanceThresholdMs"
                               min="100" max="60000">
                        <div class="form-text">
                            Operations exceeding this time will be logged when performance logging is enabled.
                        </div>
                    </div>

                    <hr class="my-3">

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="enableUploadDiagnostics"
                               name="EnableUploadDiagnostics" value="true" @(Model.EnableUploadDiagnostics ? "checked" : "")
                               onchange="toggleUploadOptions()">
                        <label class="form-check-label" for="enableUploadDiagnostics">
                            <strong>Enable Upload Diagnostics</strong>
                        </label>
                        <div class="form-text">
                            Logs detailed upload progress for debugging large file upload failures:
                            <ul class="mb-0 mt-1">
                                <li>Request details (Content-Length, headers, client info)</li>
                                <li>Streaming progress (bytes received, throughput, ETA)</li>
                                <li>Connection events (stalls, timeouts, disconnects)</li>
                                <li>Error context with full diagnostic details</li>
                            </ul>
                        </div>
                    </div>

                    <div id="uploadDiagnosticsOptions" style="display: @(Model.EnableUploadDiagnostics ? "block" : "none");">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="uploadProgressIntervalMB" class="form-label">Progress Interval (MB)</label>
                                    <input type="number" class="form-control" id="uploadProgressIntervalMB"
                                           name="UploadProgressIntervalMB" value="@Model.UploadProgressIntervalMB"
                                           min="1" max="500">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="uploadProgressIntervalPercent" class="form-label">Progress Interval (%)</label>
                                    <input type="number" class="form-control" id="uploadProgressIntervalPercent"
                                           name="UploadProgressIntervalPercent" value="@Model.UploadProgressIntervalPercent"
                                           min="1" max="50">
                                </div>
                            </div>
                        </div>
                        <div class="form-text mb-3">
                            Log progress every N MB or N% of total file size (whichever comes first).
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-calendar-minus"></i> Log Retention
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label for="fileLogRetentionDays" class="form-label">File Log Retention (days)</label>
                        <input type="number" class="form-control" id="fileLogRetentionDays"
                               name="FileLogRetentionDays" value="@Model.FileLogRetentionDays"
                               min="1" max="365">
                        <div class="form-text">
                            Number of days to retain log files on disk.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="databaseLogRetentionDays" class="form-label">Database Log Retention (days)</label>
                        <input type="number" class="form-control" id="databaseLogRetentionDays"
                               name="DatabaseLogRetentionDays" value="@Model.DatabaseLogRetentionDays"
                               min="1" max="365">
                        <div class="form-text">
                            Number of days to retain logs in the database (app.SerilogLogs table).
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <i class="bi bi-info-circle"></i> Extended Logging Details
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>When Extended Logging is enabled:</strong></p>
                    <ul class="mb-0">
                        <li><strong>Login Events:</strong> User's AD groups, matched authorization roles, and auth type</li>
                        <li><strong>LDAP:</strong> Group membership details, DN parsing, attribute values</li>
                        <li><strong>Authorization:</strong> Policy evaluation results, group matching</li>
                        <li><strong>Imports:</strong> Batch processing details, row counts, timing</li>
                    </ul>
                    <hr>
                    <p class="text-muted small mb-0">
                        <i class="bi bi-lightbulb"></i> Extended logging is useful for troubleshooting authentication
                        and authorization issues. Disable in production to reduce log volume.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i> Save Configuration
        </button>
    </div>
</form>

@section Scripts {
    <script>
        function toggleUploadOptions() {
            var checkbox = document.getElementById('enableUploadDiagnostics');
            var options = document.getElementById('uploadDiagnosticsOptions');
            options.style.display = checkbox.checked ? 'block' : 'none';
        }
    </script>
}
