@model LogsViewModel
@{
    ViewData["Title"] = "Event Logs";
}

<style>
    .sort-icon {
        font-size: 0.75rem;
        margin-left: 4px;
        opacity: 0.3;
    }
    .sort-icon.active {
        opacity: 1;
    }
    th[data-sort-column] {
        cursor: pointer;
        user-select: none;
    }
    th[data-sort-column]:hover {
        background-color: rgba(0, 0, 0, 0.05);
    }
    .log-message {
        max-width: 400px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .log-message.expanded {
        white-space: normal;
        word-break: break-word;
    }
    .exception-preview {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        cursor: pointer;
    }
    .severity-badge {
        min-width: 70px;
        text-align: center;
    }
</style>

<h1 class="mb-4">
    <i class="bi bi-journal-text"></i> Event Logs
</h1>

@if (!Model.IsDbConfigured)
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle"></i>
        <strong>Database Not Configured</strong> - Configure SQL Server connection to view event logs.
        <a asp-action="Configuration" class="alert-link">Configure Database</a>
    </div>
}
else
{
    <!-- Filters -->
    <div class="card mb-3">
        <div class="card-header">
            <i class="bi bi-funnel"></i> Filters
        </div>
        <div class="card-body">
            <form id="filterForm" method="get" class="row g-3">
                <div class="col-md-2">
                    <label for="severity" class="form-label">Severity</label>
                    <select class="form-select form-select-sm" id="severity" name="severity">
                        <option value="">All Severities</option>
                        @foreach (var sev in Model.AvailableSeverities)
                        {
                            <option value="@sev" selected="@(Model.SeverityFilter == sev)">@sev</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="category" class="form-label">Category</label>
                    <select class="form-select form-select-sm" id="category" name="category">
                        <option value="">All Categories</option>
                        @foreach (var cat in Model.AvailableCategories)
                        {
                            <option value="@cat" selected="@(Model.CategoryFilter == cat)">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="search" class="form-label">Search Message</label>
                    <input type="text" class="form-control form-control-sm" id="search" name="search"
                           value="@Model.SearchFilter" placeholder="Search in message...">
                </div>
                <div class="col-md-3">
                    <label for="uploadId" class="form-label">Upload ID</label>
                    <input type="text" class="form-control form-control-sm" id="uploadId" name="uploadId"
                           value="@Model.UploadIdFilter" placeholder="Filter by Upload ID...">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary btn-sm me-2">
                        <i class="bi bi-search"></i> Filter
                    </button>
                    <a href="@Url.Action("Logs")" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-x-circle"></i> Clear
                    </a>
                </div>
                <input type="hidden" id="sortBy" name="sortBy" value="@Model.SortBy">
                <input type="hidden" id="descending" name="descending" value="@Model.Descending.ToString().ToLower()">
                <input type="hidden" id="page" name="page" value="@Model.Page">
            </form>
        </div>
    </div>

    <!-- Results Summary -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <span class="text-muted">
                Showing @((Model.Page - 1) * Model.PageSize + 1)-@Math.Min(Model.Page * Model.PageSize, Model.TotalItems) of @Model.TotalItems.ToString("N0") logs
            </span>
        </div>
        <div>
            <select class="form-select form-select-sm" id="pageSizeSelect" style="width: auto; display: inline-block;">
                <option value="50" selected="@(Model.PageSize == 50)">50 per page</option>
                <option value="100" selected="@(Model.PageSize == 100)">100 per page</option>
                <option value="250" selected="@(Model.PageSize == 250)">250 per page</option>
            </select>
        </div>
    </div>

    <!-- Logs Table -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 160px;" data-sort-column="Timestamp" onclick="sortBy('Timestamp')">
                                Timestamp
                                <i class="bi @(Model.SortBy == "Timestamp" ? (Model.Descending ? "bi-arrow-down" : "bi-arrow-up") : "bi-arrow-down-up") sort-icon @(Model.SortBy == "Timestamp" ? "active" : "")"></i>
                            </th>
                            <th style="width: 90px;" data-sort-column="Severity" onclick="sortBy('Severity')">
                                Severity
                                <i class="bi @(Model.SortBy == "Severity" ? (Model.Descending ? "bi-arrow-down" : "bi-arrow-up") : "bi-arrow-down-up") sort-icon @(Model.SortBy == "Severity" ? "active" : "")"></i>
                            </th>
                            <th style="width: 100px;" data-sort-column="Category" onclick="sortBy('Category')">
                                Category
                                <i class="bi @(Model.SortBy == "Category" ? (Model.Descending ? "bi-arrow-down" : "bi-arrow-up") : "bi-arrow-down-up") sort-icon @(Model.SortBy == "Category" ? "active" : "")"></i>
                            </th>
                            <th style="width: 120px;" data-sort-column="Hostname" onclick="sortBy('Hostname')">
                                Hostname
                                <i class="bi @(Model.SortBy == "Hostname" ? (Model.Descending ? "bi-arrow-down" : "bi-arrow-up") : "bi-arrow-down-up") sort-icon @(Model.SortBy == "Hostname" ? "active" : "")"></i>
                            </th>
                            <th data-sort-column="Message" onclick="sortBy('Message')">
                                Message
                                <i class="bi @(Model.SortBy == "Message" ? (Model.Descending ? "bi-arrow-down" : "bi-arrow-up") : "bi-arrow-down-up") sort-icon @(Model.SortBy == "Message" ? "active" : "")"></i>
                            </th>
                            <th style="width: 100px;">Upload</th>
                            <th style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Logs.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No log entries found matching your criteria.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in Model.Logs)
                            {
                                var severityClass = log.SeverityName switch
                                {
                                    "DEBUG" => "bg-secondary",
                                    "INFO" => "bg-info",
                                    "NOTICE" => "bg-primary",
                                    "WARNING" => "bg-warning text-dark",
                                    "ERROR" => "bg-danger",
                                    "CRITICAL" => "bg-danger",
                                    "ALERT" => "bg-dark",
                                    "EMERGENCY" => "bg-dark",
                                    _ => "bg-secondary"
                                };
                                <tr>
                                    <td class="text-nowrap">
                                        <small><span data-utc="@log.Timestamp.ToString("o")" data-format="short">@log.Timestamp.ToString("g")</span></small>
                                    </td>
                                    <td>
                                        <span class="badge @severityClass severity-badge">@log.SeverityName</span>
                                    </td>
                                    <td>
                                        <small>@log.Category</small>
                                    </td>
                                    <td>
                                        <small class="text-muted">@log.Hostname</small>
                                    </td>
                                    <td>
                                        <div class="log-message" title="@log.Message" onclick="toggleMessage(this)">
                                            @log.Message
                                        </div>
                                        @if (!string.IsNullOrEmpty(log.Exception))
                                        {
                                            <div class="exception-preview text-danger small" onclick="showException('@log.LogId')">
                                                <i class="bi bi-exclamation-circle"></i> @log.Exception.Split('\n').FirstOrDefault()
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (log.UploadId.HasValue)
                                        {
                                            <a asp-controller="Upload" asp-action="Details" asp-route-id="@log.UploadId"
                                               class="text-decoration-none small" title="@log.UploadId">
                                                @log.UploadId.Value.ToString().Substring(0, 8)...
                                            </a>
                                        }
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-link p-0"
                                                onclick="showLogDetails(@log.LogId)" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Log pagination" class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" href="javascript:void(0)" onclick="goToPage(1)">
                        <i class="bi bi-chevron-double-left"></i>
                    </a>
                </li>
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" href="javascript:void(0)" onclick="goToPage(@(Model.Page - 1))">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @{
                    var startPage = Math.Max(1, Model.Page - 2);
                    var endPage = Math.Min(Model.TotalPages, Model.Page + 2);

                    if (startPage > 1)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }

                    for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.Page ? "active" : "")">
                            <a class="page-link" href="javascript:void(0)" onclick="goToPage(@i)">@i</a>
                        </li>
                    }

                    if (endPage < Model.TotalPages)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="javascript:void(0)" onclick="goToPage(@(Model.Page + 1))">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="javascript:void(0)" onclick="goToPage(@Model.TotalPages)">
                        <i class="bi bi-chevron-double-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
}

<!-- Log Details Modal -->
<div class="modal fade" id="logDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-info-circle"></i> Log Entry Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="logDetailsContent">
                <!-- Content loaded dynamically -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Exception Modal -->
<div class="modal fade" id="exceptionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> Exception Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <pre id="exceptionContent" class="bg-light p-3 rounded" style="max-height: 500px; overflow: auto;"></pre>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary mt-3">
    <i class="bi bi-arrow-left"></i> Back to Dashboard
</a>

@section Scripts {
    <script>
        // Store logs data for detail view
        const logsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Logs, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

        function sortBy(column) {
            const currentSort = document.getElementById('sortBy').value;
            const currentDesc = document.getElementById('descending').value === 'true';

            if (currentSort === column) {
                // Toggle direction
                document.getElementById('descending').value = (!currentDesc).toString().toLowerCase();
            } else {
                // New column, default to descending for Timestamp, ascending for others
                document.getElementById('sortBy').value = column;
                document.getElementById('descending').value = (column === 'Timestamp' ? 'true' : 'false');
            }

            document.getElementById('page').value = '1';
            document.getElementById('filterForm').submit();
        }

        function goToPage(page) {
            document.getElementById('page').value = page;
            document.getElementById('filterForm').submit();
        }

        function toggleMessage(element) {
            element.classList.toggle('expanded');
        }

        function showLogDetails(logId) {
            const log = logsData.find(l => l.logId === logId);
            if (!log) return;

            const severityClass = getSeverityClass(log.severityName);
            const content = `
                <div class="row">
                    <div class="col-md-6">
                        <dl>
                            <dt>Log ID</dt>
                            <dd>${log.logId}</dd>
                            <dt>Timestamp</dt>
                            <dd>${new Date(log.timestamp).toLocaleString()}</dd>
                            <dt>Severity</dt>
                            <dd><span class="badge ${severityClass}">${log.severityName}</span></dd>
                            <dt>Category</dt>
                            <dd>${log.category || '-'}</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl>
                            <dt>Hostname</dt>
                            <dd>${log.hostname}</dd>
                            <dt>Message ID</dt>
                            <dd>${log.messageId || '-'}</dd>
                            <dt>User ID</dt>
                            <dd>${log.userId || '-'}</dd>
                            <dt>Source IP</dt>
                            <dd>${log.sourceIP || '-'}</dd>
                            ${log.uploadId ? `<dt>Upload ID</dt><dd><a href="/Upload/Details/${log.uploadId}">${log.uploadId}</a></dd>` : ''}
                        </dl>
                    </div>
                </div>
                <hr>
                <h6>Message</h6>
                <div class="bg-light p-3 rounded">${escapeHtml(log.message)}</div>
                ${log.exception ? `
                    <hr>
                    <h6 class="text-danger">Exception</h6>
                    <pre class="bg-light p-3 rounded text-danger" style="max-height: 300px; overflow: auto;">${escapeHtml(log.exception)}</pre>
                ` : ''}
            `;

            document.getElementById('logDetailsContent').innerHTML = content;
            new bootstrap.Modal(document.getElementById('logDetailsModal')).show();
        }

        function showException(logId) {
            const log = logsData.find(l => l.logId === logId);
            if (!log || !log.exception) return;

            document.getElementById('exceptionContent').textContent = log.exception;
            new bootstrap.Modal(document.getElementById('exceptionModal')).show();
        }

        function getSeverityClass(severity) {
            switch (severity) {
                case 'DEBUG': return 'bg-secondary';
                case 'INFO': return 'bg-info';
                case 'NOTICE': return 'bg-primary';
                case 'WARNING': return 'bg-warning text-dark';
                case 'ERROR': return 'bg-danger';
                case 'CRITICAL': return 'bg-danger';
                case 'ALERT': return 'bg-dark';
                case 'EMERGENCY': return 'bg-dark';
                default: return 'bg-secondary';
            }
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Page size change handler
        document.getElementById('pageSizeSelect')?.addEventListener('change', function() {
            const url = new URL(window.location);
            url.searchParams.set('pageSize', this.value);
            url.searchParams.set('page', '1');
            window.location = url;
        });

        // Auto-submit on filter change (with debounce for text inputs)
        document.getElementById('severity')?.addEventListener('change', function() {
            document.getElementById('page').value = '1';
            document.getElementById('filterForm').submit();
        });

        document.getElementById('category')?.addEventListener('change', function() {
            document.getElementById('page').value = '1';
            document.getElementById('filterForm').submit();
        });

        let searchTimeout;
        document.getElementById('search')?.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                document.getElementById('page').value = '1';
                document.getElementById('filterForm').submit();
            }, 500);
        });
    </script>
}
