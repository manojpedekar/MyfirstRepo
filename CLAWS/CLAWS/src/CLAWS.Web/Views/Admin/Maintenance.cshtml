@model MaintenanceViewModel
@using CLAWS.Jobs
@{
    ViewData["Title"] = "Maintenance";
    var truncatingSchema = TempData["TruncatingSchema"] as string;
    var truncatingProgressId = TempData["TruncatingProgressId"] as string;
}

<h1 class="mb-4">
    <i class="bi bi-wrench-adjustable"></i> Database Maintenance
</h1>

@* Success/Error messages from TempData are displayed by _Layout.cshtml *@
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(truncatingSchema))
{
    <div class="alert alert-info" id="truncate-progress-alert">
        <i class="bi bi-hourglass-split"></i>
        <strong>Truncation job started for [@truncatingSchema].</strong>
        <span id="truncate-status">Initializing...</span>
        <div class="progress mt-2" style="height: 8px;">
            <div id="truncate-progress-bar" class="progress-bar progress-bar-striped progress-bar-animated bg-info"
                 role="progressbar" style="width: 0%"></div>
        </div>
    </div>
}

<div class="alert alert-warning">
    <h5><i class="bi bi-exclamation-triangle-fill"></i> Warning</h5>
    <p class="mb-0">
        This page allows you to <strong>permanently delete all data</strong> from the selected schema.
        Truncation runs as a background job with batched deletes to handle large tables reliably.
        Progress is shown in real-time.
    </p>
</div>

<div class="row">
    @foreach (var schema in Model.Schemas)
    {
        var progressId = SchemaTruncateJob.GetProgressId(schema.SchemaName);
        var isCurrentlyTruncating = truncatingSchema == schema.SchemaName;
        <div class="col-md-6 mb-4">
            <div class="card border-@schema.StyleClass" data-schema="@schema.SchemaName" data-progress-id="@progressId">
                <div class="card-header bg-@schema.StyleClass text-white d-flex justify-content-between align-items-center">
                    <span>
                        <i class="bi bi-database"></i> @schema.DisplayName
                    </span>
                    <span class="badge bg-light text-dark">[@schema.SchemaName]</span>
                </div>
                <div class="card-body">
                    <p class="text-muted">@schema.Description</p>

                    <div class="row mb-3">
                        <div class="col-6">
                            <div class="border rounded p-2 text-center">
                                <div class="fs-4 fw-bold">@schema.TableCount</div>
                                <small class="text-muted">Tables</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-2 text-center">
                                <div class="fs-4 fw-bold schema-row-count">@schema.TotalRows.ToString("N0")</div>
                                <small class="text-muted">Total Rows</small>
                            </div>
                        </div>
                    </div>

                    @if (schema.Tables.Count > 0)
                    {
                        <details class="mb-3">
                            <summary class="text-muted cursor-pointer">
                                <small>View table details</small>
                            </summary>
                            <div class="mt-2">
                                <table class="table table-sm table-striped mb-0">
                                    <thead>
                                        <tr>
                                            <th>Table</th>
                                            <th class="text-end">Rows</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var table in schema.Tables)
                                        {
                                            <tr>
                                                <td><small>@table.TableName</small></td>
                                                <td class="text-end"><small>@table.RowCount.ToString("N0")</small></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                    else
                    {
                        <p class="text-muted mb-3"><small>No tables found in this schema.</small></p>
                    }

                    <div class="schema-action-container">
                        <form asp-action="TruncateSchema" method="post" class="truncate-form"
                              onsubmit="return confirmTruncate('@schema.DisplayName', '@schema.SchemaName', @schema.TotalRows);">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="schemaName" value="@schema.SchemaName" />
                            <button type="submit" class="btn btn-@schema.StyleClass w-100 truncate-btn @(isCurrentlyTruncating ? "d-none" : "")"
                                    @(schema.TableCount == 0 ? "disabled" : "")>
                                <i class="bi bi-trash3"></i> Truncate All [@schema.SchemaName] Tables
                            </button>
                        </form>
                        <div class="truncate-progress @(isCurrentlyTruncating ? "" : "d-none")">
                            <div class="d-flex align-items-center mb-2">
                                <div class="spinner-border spinner-border-sm text-@schema.StyleClass me-2" role="status"></div>
                                <span class="truncate-progress-text">Processing...</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar progress-bar-striped progress-bar-animated bg-@schema.StyleClass truncate-progress-bar"
                                     role="progressbar" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (Model.Schemas.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No schema information available. The database may not be configured or the schemas may not exist yet.
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary mt-3">
    <i class="bi bi-arrow-left"></i> Back to Dashboard
</a>

@section Scripts {
    <script>
        function confirmTruncate(displayName, schemaName, rowCount) {
            const formattedRows = rowCount.toLocaleString();
            const message = `Are you sure you want to PERMANENTLY DELETE all data from "${displayName}" [${schemaName}]?\n\n` +
                `This will delete approximately ${formattedRows} rows across all tables.\n\n` +
                `The truncation will run as a background job - you can safely leave this page.\n\n` +
                `This action CANNOT be undone!\n\n` +
                `Type "DELETE" to confirm:`;

            const confirmation = prompt(message);
            if (confirmation !== 'DELETE') {
                if (confirmation !== null) {
                    alert('Truncate cancelled. You must type "DELETE" exactly to confirm.');
                }
                return false;
            }

            // Show immediate feedback
            const card = document.querySelector(`[data-schema="${schemaName}"]`);
            if (card) {
                const btn = card.querySelector('.truncate-btn');
                const progress = card.querySelector('.truncate-progress');
                if (btn) btn.classList.add('d-none');
                if (progress) progress.classList.remove('d-none');
            }

            return true;
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Get the progress ID if a truncation was just started
            var truncatingProgressId = '@(truncatingProgressId ?? "")';

            // Collect all schema progress IDs for subscription
            var schemaCards = document.querySelectorAll('[data-progress-id]');
            var progressIds = [];
            schemaCards.forEach(function(card) {
                progressIds.push(card.getAttribute('data-progress-id'));
            });

            if (progressIds.length === 0) return;

            // Connect to SignalR
            var connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/upload')
                .withAutomaticReconnect()
                .build();

            connection.on('ProgressUpdate', function(data) {
                console.log('Progress update:', data);

                // Find the card for this progress update
                var card = document.querySelector('[data-progress-id="' + data.uploadId + '"]');
                if (!card) return;

                var btn = card.querySelector('.truncate-btn');
                var progressContainer = card.querySelector('.truncate-progress');
                var progressBar = progressContainer ? progressContainer.querySelector('.truncate-progress-bar') : null;
                var progressText = progressContainer ? progressContainer.querySelector('.truncate-progress-text') : null;
                var spinner = progressContainer ? progressContainer.querySelector('.spinner-border') : null;

                // Show progress, hide button
                if (btn) btn.classList.add('d-none');
                if (progressContainer) progressContainer.classList.remove('d-none');

                // Update progress bar
                if (progressBar) {
                    progressBar.style.width = data.percent + '%';
                }

                // Update status text
                if (progressText) {
                    var msg = data.message;
                    if (data.currentTable) {
                        var tableName = data.currentTable.split('.').pop();
                        msg = tableName + ' - ' + data.percent + '%';
                    }
                    progressText.textContent = msg;
                }

                // Also update the global alert if present
                var globalStatus = document.getElementById('truncate-status');
                var globalBar = document.getElementById('truncate-progress-bar');
                if (globalStatus) globalStatus.textContent = data.message;
                if (globalBar) globalBar.style.width = data.percent + '%';

                if (data.phase === 'Completed') {
                    if (progressBar) {
                        progressBar.classList.remove('progress-bar-animated', 'progress-bar-striped');
                        progressBar.classList.add('bg-success');
                    }
                    if (globalBar) {
                        globalBar.classList.remove('progress-bar-animated', 'progress-bar-striped', 'bg-info');
                        globalBar.classList.add('bg-success');
                    }
                    if (spinner) spinner.classList.add('d-none');
                    if (progressText) progressText.textContent = 'Completed! Refreshing...';
                    if (globalStatus) globalStatus.textContent = 'Completed! Refreshing...';

                    // Refresh page to show updated row counts
                    setTimeout(function() {
                        window.location.reload();
                    }, 2000);
                } else if (data.phase === 'Failed') {
                    if (progressBar) {
                        progressBar.classList.remove('progress-bar-animated', 'progress-bar-striped');
                        progressBar.classList.add('bg-danger');
                    }
                    if (globalBar) {
                        globalBar.classList.remove('progress-bar-animated', 'progress-bar-striped', 'bg-info');
                        globalBar.classList.add('bg-danger');
                    }
                    if (spinner) spinner.classList.add('d-none');
                    if (progressText) {
                        progressText.classList.add('text-danger');
                        progressText.textContent = 'Failed: ' + data.message;
                    }

                    // Show button again after failure
                    setTimeout(function() {
                        if (btn) btn.classList.remove('d-none');
                        if (progressContainer) progressContainer.classList.add('d-none');
                    }, 5000);
                }
            });

            connection.start().then(function() {
                console.log('SignalR connected, subscribing to', progressIds.length, 'schema progress IDs');
                // Subscribe to all schema progress IDs
                progressIds.forEach(function(id) {
                    connection.invoke('SubscribeToUpload', id);
                });
            }).catch(function(err) {
                console.error('SignalR connection error:', err);
            });
        });
    </script>
}
