@model UploadsViewModel
@{
    ViewData["Title"] = "All Uploads";
}

<h1 class="mb-4">
    <i class="bi bi-list-ul"></i> All Uploads
</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        <i class="bi bi-funnel"></i> Filters
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-auto">
                <label for="status" class="form-label">Status</label>
                <select name="status" id="status" class="form-select">
                    <option value="">All</option>
                    @{
                        var statuses = new[] { "Pending", "Processing", "Uploading", "Validating", "Queued", "Importing", "Completed", "Failed", "Cancelled" };
                        foreach (var s in statuses)
                        {
                            if (Model.StatusFilter == s)
                            {
                                <option value="@s" selected>@s</option>
                            }
                            else
                            {
                                <option value="@s">@s</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filter
                </button>
                <a asp-action="Uploads" class="btn btn-outline-secondary">
                    <i class="bi bi-x"></i> Clear
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            <i class="bi bi-cloud-upload"></i> Uploads
            @if (!string.IsNullOrEmpty(Model.StatusFilter))
            {
                <span class="badge bg-secondary">@Model.StatusFilter</span>
            }
        </span>
        <span class="text-muted">
            Showing @((Model.Page - 1) * Model.PageSize + 1)-@Math.Min(Model.Page * Model.PageSize, Model.TotalItems) of @Model.TotalItems
        </span>
    </div>
    <div class="card-body">
        @if (Model.Uploads.Count == 0)
        {
            <p class="text-muted">No uploads found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Filename</th>
                            <th>Type</th>
                            <th>Size</th>
                            <th>Status</th>
                            <th>Progress</th>
                            <th>Uploaded</th>
                            <th>Completed</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var upload in Model.Uploads)
                        {
                            <tr>
                                <td>
                                    <span title="@upload.UploadId">@upload.OriginalFilename</span>
                                </td>
                                <td>
                                    @{
                                        var typeDisplay = upload.UploadType switch
                                        {
                                            "NTFSPermissions" => "NTFS Perms",
                                            "ADInventory" => "AD Inventory",
                                            _ => upload.UploadType ?? "Unknown"
                                        };
                                    }
                                    <small class="text-muted">@typeDisplay</small>
                                </td>
                                <td>@((upload.FileSizeBytes / 1024.0 / 1024.0).ToString("N1")) MB</td>
                                <td>
                                    @{
                                        var statusClass = upload.Status switch
                                        {
                                            "Completed" => "bg-success",
                                            "Failed" => "bg-danger",
                                            "Cancelled" => "bg-secondary",
                                            "Importing" => "bg-info",
                                            "Processing" => "bg-info",
                                            "Pending" => "bg-warning text-dark",
                                            "Queued" => "bg-warning text-dark",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @statusClass">@upload.Status</span>
                                </td>
                                <td>
                                    @if (upload.Status is "Importing" or "Processing" && upload.ImportProgress.HasValue)
                                    {
                                        <div class="progress" style="min-width: 100px;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                                 role="progressbar"
                                                 style="width: @upload.ImportProgress%;"
                                                 aria-valuenow="@upload.ImportProgress"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                                @upload.ImportProgress%
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(upload.CurrentPhase))
                                        {
                                            <small class="text-muted">@upload.CurrentPhase</small>
                                        }
                                    }
                                    else if (!string.IsNullOrEmpty(upload.StatusMessage))
                                    {
                                        <small class="text-muted" title="@upload.StatusMessage">
                                            @(upload.StatusMessage.Length > 30 ? upload.StatusMessage.Substring(0, 30) + "..." : upload.StatusMessage)
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td><small><span data-utc="@upload.UploadedAt.ToString("o")" data-format="short">@upload.UploadedAt.ToString("g")</span></small></td>
                                <td>
                                    @if (upload.CompletedAt.HasValue)
                                    {
                                        <small><span data-utc="@upload.CompletedAt.Value.ToString("o")" data-format="short">@upload.CompletedAt.Value.ToString("g")</span></small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Upload" asp-action="Status" asp-route-id="@upload.UploadId"
                                       class="btn btn-sm btn-outline-primary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (upload.CanRestart)
                                    {
                                        <form asp-action="RestartUpload" method="post" style="display: inline;">
                                            <input type="hidden" name="uploadId" value="@upload.UploadId" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Restart Import"
                                                    onclick="return confirm('Are you sure you want to restart this import?');">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        @if (Model.Page > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Uploads" asp-route-page="@(Model.Page - 1)" asp-route-status="@Model.StatusFilter">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link"><i class="bi bi-chevron-left"></i></span>
                            </li>
                        }

                        @{
                            var startPage = Math.Max(1, Model.Page - 2);
                            var endPage = Math.Min(Model.TotalPages, Model.Page + 2);
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Uploads" asp-route-page="1" asp-route-status="@Model.StatusFilter">1</a>
                            </li>
                            @if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            if (i == Model.Page)
                            {
                                <li class="page-item active">
                                    <span class="page-link">@i</span>
                                </li>
                            }
                            else
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Uploads" asp-route-page="@i" asp-route-status="@Model.StatusFilter">@i</a>
                                </li>
                            }
                        }

                        @if (endPage < Model.TotalPages)
                        {
                            @if (endPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" asp-action="Uploads" asp-route-page="@Model.TotalPages" asp-route-status="@Model.StatusFilter">@Model.TotalPages</a>
                            </li>
                        }

                        @if (Model.Page < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Uploads" asp-route-page="@(Model.Page + 1)" asp-route-status="@Model.StatusFilter">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item disabled">
                                <span class="page-link"><i class="bi bi-chevron-right"></i></span>
                            </li>
                        }
                    </ul>
                </nav>
            }
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary mt-3">
    <i class="bi bi-arrow-left"></i> Back to Dashboard
</a>
