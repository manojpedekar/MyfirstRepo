@model CLAWS.Web.Controllers.HelpIndexViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container-fluid px-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <!-- Header -->
            <div class="text-center mb-5">
                <h1 class="display-5 mb-3">
                    <i class="bi bi-question-circle text-primary"></i> @Model.Title
                </h1>
                <p class="lead text-muted">@Model.Description</p>
            </div>

            <!-- Popular Articles -->
            @if (Model.PopularArticles.Any())
            {
                <div class="card mb-4 border-primary">
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-star-fill"></i> Popular Articles
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var article in Model.PopularArticles)
                        {
                            <a asp-action="Article" asp-route-category="@article.SectionId" asp-route-article="@article.ArticleId"
                               class="list-group-item list-group-item-action d-flex align-items-center">
                                <i class="@(article.SectionIcon ?? "bi bi-file-text") text-muted me-3"></i>
                                <div>
                                    <div>@article.ArticleTitle</div>
                                    <small class="text-muted">@article.SectionTitle</small>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }

            <!-- Documentation Sections -->
            <div class="row g-4">
                @foreach (var helpSection in Model.Sections)
                {
                    <div class="col-md-6">
                        <div class="card h-100">
                            <div class="card-header">
                                <i class="@(helpSection.Icon ?? "bi bi-folder")"></i> @helpSection.Title
                            </div>
                            <div class="card-body">
                                @if (!string.IsNullOrEmpty(helpSection.Description))
                                {
                                    <p class="card-text text-muted small mb-3">@helpSection.Description</p>
                                }
                                <ul class="list-unstyled mb-0">
                                    @foreach (var article in helpSection.Articles)
                                    {
                                        <li class="mb-2">
                                            <a asp-action="Article" asp-route-category="@helpSection.Id" asp-route-article="@article.Id">
                                                <i class="bi bi-chevron-right small"></i> @article.Title
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Contact Section -->
            @if (!string.IsNullOrEmpty(Model.ContactEmail))
            {
                <div class="card mt-4 bg-light">
                    <div class="card-body text-center">
                        <h5><i class="bi bi-envelope"></i> Need Help?</h5>
                        <p class="mb-2">Can't find what you're looking for?</p>
                        <a href="mailto:@Model.ContactEmail" class="btn btn-outline-primary">
                            Contact Support
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
