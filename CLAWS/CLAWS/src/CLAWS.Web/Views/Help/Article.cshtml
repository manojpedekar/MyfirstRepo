@model CLAWS.Web.Controllers.HelpArticleViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3 col-xl-2 d-none d-lg-block">
            <div class="position-sticky" style="top: 1rem;">
                <div class="mb-3">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">
                        <i class="bi bi-arrow-left"></i> All Help Topics
                    </a>
                </div>

                @foreach (var helpSection in Model.AllSections)
                {
                    var isCurrentSection = helpSection.Id == Model.SectionId;
                    <div class="mb-3">
                        <h6 class="text-uppercase text-muted small mb-2">
                            <i class="@(helpSection.Icon ?? "bi bi-folder")"></i> @helpSection.Title
                        </h6>
                        <ul class="nav flex-column">
                            @foreach (var article in helpSection.Articles)
                            {
                                var isActive = isCurrentSection && article.Id == Model.CurrentArticle?.Id;
                                <li class="nav-item">
                                    <a asp-action="Article" asp-route-category="@helpSection.Id" asp-route-article="@article.Id"
                                       class="nav-link py-1 @(isActive ? "active fw-bold text-primary" : "text-body")">
                                        @article.Title
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9 col-xl-10">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index"><i class="bi bi-question-circle"></i> Help</a>
                    </li>
                    @if (!string.IsNullOrEmpty(Model.SectionTitle))
                    {
                        <li class="breadcrumb-item">
                            <a asp-action="Article" asp-route-category="@Model.SectionId" asp-route-article="index">
                                @Model.SectionTitle
                            </a>
                        </li>
                    }
                    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                </ol>
            </nav>

            <!-- Mobile Section Dropdown -->
            <div class="d-lg-none mb-3">
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle w-100" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-list"></i> Browse Topics
                    </button>
                    <ul class="dropdown-menu w-100">
                        @foreach (var helpSection in Model.AllSections)
                        {
                            <li><h6 class="dropdown-header"><i class="@(helpSection.Icon ?? "bi bi-folder")"></i> @helpSection.Title</h6></li>
                            @foreach (var article in helpSection.Articles)
                            {
                                <li>
                                    <a class="dropdown-item" asp-action="Article" asp-route-category="@helpSection.Id" asp-route-article="@article.Id">
                                        @article.Title
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>

            <!-- Article Content -->
            <div class="card">
                <div class="card-header">
                    @if (!string.IsNullOrEmpty(Model.SectionIcon))
                    {
                        <i class="@Model.SectionIcon"></i>
                    }
                    <span>@Model.Title</span>
                </div>
                <div class="card-body">
                    <article class="markdown-body">
                        @Html.Raw(Model.HtmlContent)
                    </article>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Markdown content styling */
        .markdown-body h1 { font-size: 1.75rem; margin-top: 1.5rem; margin-bottom: 1rem; }
        .markdown-body h2 { font-size: 1.5rem; margin-top: 1.5rem; margin-bottom: 0.75rem; border-bottom: 1px solid #dee2e6; padding-bottom: 0.5rem; }
        .markdown-body h3 { font-size: 1.25rem; margin-top: 1.25rem; margin-bottom: 0.5rem; }
        .markdown-body h4 { font-size: 1.1rem; margin-top: 1rem; margin-bottom: 0.5rem; }
        .markdown-body pre { background-color: #f6f8fa; border: 1px solid #dee2e6; border-radius: 0.375rem; padding: 1rem; overflow-x: auto; }
        .markdown-body code { background-color: #f6f8fa; padding: 0.125rem 0.375rem; border-radius: 0.25rem; font-size: 0.875em; }
        .markdown-body pre code { background-color: transparent; padding: 0; }
        .markdown-body table { width: 100%; margin-bottom: 1rem; border-collapse: collapse; }
        .markdown-body table th, .markdown-body table td { padding: 0.5rem; border: 1px solid #dee2e6; }
        .markdown-body table th { background-color: #f8f9fa; font-weight: 600; }
        .markdown-body table tr:nth-child(even) { background-color: #f8f9fa; }
        .markdown-body blockquote { border-left: 4px solid #dee2e6; padding-left: 1rem; margin-left: 0; color: #6c757d; }
        .markdown-body ul, .markdown-body ol { padding-left: 2rem; }
        .markdown-body li { margin-bottom: 0.25rem; }
        .markdown-body hr { margin: 2rem 0; border-top: 1px solid #dee2e6; }
        .markdown-body a { color: #0d6efd; }
        .markdown-body img { max-width: 100%; height: auto; }
    </style>
}
