          "rawSql": "SELECT TOP (50) [ComputerId]\r\n\t,[FullDomainName] AS [FQDN]\r\n\t,[TargetGroupName] AS [Target Group]\r\n\t,[Needed]\r\n\t,[Failed]\r\n\t,CAST([OSMajorVersion] AS NVARCHAR(10)) + '.' + CAST([OSMinorVersion] AS NVARCHAR(10)) + '.' + CAST([OSBuildNumber] AS NVARCHAR(10)) + \r\n\tCASE \r\n\t\tWHEN [OSServicePackMajorNumber] > 0\r\n\t\t\tTHEN ' SP' + CAST([OSServicePackMajorNumber] AS NVARCHAR(10))\r\n\t\tELSE ''\r\n\tEND AS [OS Version]\r\nFROM [SUSDB_Reports].[dbo].[tb_DailySummariesPerComputer]\r\nWHERE [Date] = ( SELECT MAX([Date])\r\n\t\tFROM [SUSDB_Reports].[dbo].[tb_DailySummariesPerComputer] )\r\nORDER BY [Failed] DESC",
