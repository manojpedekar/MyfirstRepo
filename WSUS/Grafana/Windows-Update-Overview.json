          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "DECLARE @MsrcSeverity nvarchar(15);\r\nSET @MsrcSeverity = 'Critical';\r\n\r\nDECLARE @SQL nvarchar(MAX);\r\nSET @SQL = '\r\nSELECT \r\n    [DATE],\r\n    [MsrcSeverity],\r\n    COUNT(*) AS ' + QUOTENAME(@MsrcSeverity) + '\r\nFROM \r\n    [SUSDB_Reports].[dbo].[tb_UpdatesNeededByComputerHistory]\r\nWHERE \r\n    [MsrcSeverity] = @MsrcSeverity \r\nGROUP BY \r\n    [DATE],\r\n    [MsrcSeverity]\r\nORDER BY \r\n    [DATE], \r\n    [MsrcSeverity];\r\n';\r\n\r\nDECLARE @RunScript as bit;\r\n\r\nSELECT @RunScript = \r\n  CASE\r\n    WHEN @MsrcSeverity IN ($frmMsrcSeverity)\r\n    or 'All' IN ($frmMsrcSeverity) THEN 1\r\n    ELSE 0\r\n  END\r\n\r\nIF @RunScript = 1\r\nBEGIN\r\n    EXEC sp_executesql @SQL, N'@MsrcSeverity nvarchar(15)', @MsrcSeverity = @MsrcSeverity;\r\nEND\r\n",
