          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n    ua.CreationDate as [Creation Date]\r\n\t,u.[DefaultTitle] as Title\r\n      ,u.[IsDeclined] as [Is Declined]\r\n      ,u.[MsrcSeverity] as [MSRC Severity]\r\n      ,u.[KnowledgebaseArticle] as [KB Article]\r\nFROM\r\n    PUBLIC_VIEWS.vUpdateApproval as ua\r\nLEFT JOIN [SUSDB].[PUBLIC_VIEWS].[vUpdate] as u on ua.UpdateId = u.UpdateId\r\nWHERE\r\n    Action = 'Install' -- assuming you are interested in patches that were approved for install\r\n    AND $__timeFilter(ua.CreationDate)\r\nORDER BY ua.CreationDate DESC\r\n\r\n",
          "refId": "A",
