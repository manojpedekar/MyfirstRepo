          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'EffectiveLastDetectionTime' AS Process, CAST([EffectiveLastDetectionTime] AS NVARCHAR(MAX)) AS [Date/Time]\r\nFROM [SUSDB_Reports].[dbo].[vw_SummaryStatus_Computer]\r\nWHERE [ComputerId] = ('$ComputerID')\r\nUNION ALL\r\nSELECT 'LastReportedStatusTime', CAST([LastReportedStatusTime] AS NVARCHAR(MAX))\r\nFROM [SUSDB_Reports].[dbo].[vw_SummaryStatus_Computer]\r\nWHERE [ComputerId] = ('$ComputerID')\r\nUNION ALL\r\nSELECT 'LastSyncTime', CAST([LastSyncTime] AS NVARCHAR(MAX))\r\nFROM [SUSDB_Reports].[dbo].[vw_SummaryStatus_Computer]\r\nWHERE [ComputerId] = ('$ComputerID')\r\nUNION ALL\r\nSELECT 'CreatedTime', CAST([CreatedTime] AS NVARCHAR(MAX))\r\nFROM [SUSDB_Reports].[dbo].[vw_SummaryStatus_Computer]\r\nWHERE [ComputerId] = ('$ComputerID')\r\n",
