          "format": "table",
          "rawQuery": true,
          "rawSql": "DECLARE @Results TABLE (\r\n    [Action] NVARCHAR(MAX),\r\n    [UPDATE] NVARCHAR(MAX),\r\n    [Time at Client] DATETIME,\r\n    [Time at WSUS Server] DATETIME,\r\n    [State] NVARCHAR(MAX)\r\n);\r\n\r\n-- Store the results of the first query in the table variable\r\nINSERT INTO @Results ([Action], [UPDATE], [Time at Client], [Time at WSUS Server], [State])\r\nSELECT [MessageTemplate] AS [Action],\r\n       [DefaultTitle] AS [UPDATE],\r\n       [TimeAtTarget] AS [Time at Client],\r\n       [TimeAtServer] AS [Time at WSUS Server],\r\n       [State]\r\nFROM [SUSDB_Reports].[dbo].[vw_GetWSUSEvents]\r\nWHERE [ComputerId] = ('$ComputerID');\r\n\r\n-- Check if any rows were returned\r\nIF (SELECT COUNT(*) FROM @Results) > 0\r\n    -- If rows exist, select them\r\n    SELECT * FROM @Results\r\n    ORDER BY [Time at Client] DESC ;\r\nELSE\r\n    -- If no rows exist, return a message\r\n    SELECT 'No Data Present' AS Message;\r\n",
          "refId": "A",
