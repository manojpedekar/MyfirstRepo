          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT S.[KnowledgebaseArticle] AS [KB]\r\n      ,S.[IsDeclined] AS [Declined]\r\n      ,S.[MsrcSeverity] as [MSRC Severity]\r\n      ,S.[SecurityBulletin] AS [Security Bulletin]\r\n      ,S.[InstallationCanRequestUserInput] as [User Input Needed]\r\n      ,S.[InstallationRequiresNetworkConnectivity] as [Requires Network]\r\n      ,S.[InstallationImpact] AS [Installation Impact]\r\n      ,S.[InstallationRebootBehavior] as [Reboot Behavior]\r\n      ,S.[Classification]\r\n      ,M.[UninstallationSupported] as [Uninstallation Supported]\r\n      ,M.[IsLatestRevision] as [Is Latest Revision]\r\n  FROM [SUSDB_Reports].[dbo].[vw_SummaryStatus_Update] AS S\r\n  LEFT JOIN [SUSDB].[dbo].[vwMinimalUpdate] AS M ON S.UpdateID = M.UpdateID\r\n  WHERE S.[UpdateId] = ('$UpdateID')",
