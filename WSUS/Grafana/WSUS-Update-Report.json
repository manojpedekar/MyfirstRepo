          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'Arrival Date' AS [Property], CONVERT(VARCHAR, S.[ArrivalDate]) AS Value\r\nFROM [SUSDB_Reports].[dbo].[vw_SummaryStatus_Update] AS S\r\nLEFT JOIN [SUSDB].[PUBLIC_VIEWS].[vUpdateAdditionalInfoUrl] AS URL \r\n    ON S.[UpdateId] = URL.[UpdateId] and [LocaleId] = 1033\r\nWHERE S.[UpdateId] = ('$UpdateID')\r\n\r\nUNION ALL\r\n\r\nSELECT 'Creation Date', CONVERT(VARCHAR, S.[CreationDate])\r\nFROM [SUSDB_Reports].[dbo].[vw_SummaryStatus_Update] AS S\r\nLEFT JOIN [SUSDB].[PUBLIC_VIEWS].[vUpdateAdditionalInfoUrl] AS URL \r\n    ON S.[UpdateId] = URL.[UpdateId] and [LocaleId] = 1033\r\nWHERE S.[UpdateId] = ('$UpdateID')\r\n\r\n",
          "refId": "A",
