          "rawQuery": true,
          "rawSql": "SELECT\r\n  i.patching_group as 'Patching Group',\r\n  i.ssnc_environment as 'Environment',\r\n  c.SN_SYS_ID as 'ServiceNow SYSID',\r\n  i.salt_minion_id as 'Minion Name',\r\n  i.dns_name as 'DNS Name',\r\n  i.osconfigfullname as OS,\r\n  i.ssnc_datacenter as Datacenter,\r\n  appdisplayname as [App Name],\r\n  IsCloud,\r\n  i.host as HostName\r\nFROM\r\n  [InfrasrtructureInventory].[dbo].[Merged_VMData_v2] i\r\n  LEFT JOIN [EDW_PROD].[CMDB].[MASTER_SERVER] c ON i.host = c.SERVER_NAME\r\nWHERE\r\n  i.host in ($hostlist)",
