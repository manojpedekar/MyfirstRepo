          "rawSql": "SELECT \r\n      [ComputerId],\r\n      [FullDomainName],\r\n      [IPAddress],\r\n      [TargetGroupName],\r\n      [Needed],\r\n      [Failed],\r\n      [EffectiveLastDetectionTime],\r\n      [LastReportedStatusTime],\r\n      [LastSyncTime],\r\n      [CreatedTime],\r\n      [ClientVersion],\r\n      [OSDescription],\r\n      [InsertionDateTime],\r\n      [SUSDB_Reports].[dbo].[fn_ExtractHostName]([FullDomainName]) as [HostName],\r\n      CONCAT(\r\n            [OSMajorVersion], '.',\r\n            [OSMinorVersion], '.',\r\n            [OSBuildNumber], ' SP',\r\n            [OSServicePackMajorNumber], '.',\r\n            [OSServicePackMinorNumber]\r\n      ) AS [OSVersion]\r\nFROM \r\n      [SUSDB_Reports].[dbo].[tb_Systems_Issues_Reporting]\r\n",
